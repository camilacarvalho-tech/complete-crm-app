# Variáveis do Nexus Leads Monitor (SPA) — produção

# Após deploy das Functions (requer Blaze):
VITE_LEADS_MONITOR_SAVE_SECRET_URL=https://southamerica-east1-recomece-cred-oficial.cloudfunctions.net/leadsMonitorSaveSecret
VITE_LEADS_MONITOR_PLACES_URL=https://southamerica-east1-recomece-cred-oficial.cloudfunctions.net/leadsMonitorPlacesSearch
VITE_LEADS_MONITOR_OVERPASS_URL=https://southamerica-east1-recomece-cred-oficial.cloudfunctions.net/leadsMonitorOverpassSearch

# Emulador local:
# VITE_LEADS_MONITOR_PLACES_URL=http://127.0.0.1:5001/recomece-cred-oficial/southamerica-east1/leadsMonitorPlacesSearch
# VITE_LEADS_MONITOR_OVERPASS_URL=http://127.0.0.1:5001/recomece-cred-oficial/southamerica-east1/leadsMonitorOverpassSearch

# Opcional — só se o conector API no browser precisar descriptografar Bearer.
# Preferível authType=none; não versionar valor real.
# VITE_LEADS_MONITOR_KEK=
