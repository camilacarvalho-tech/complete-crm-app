# Copie para .env (não versionado) antes do deploy das Functions.
# Gere um valor aleatório forte, ex.: openssl rand -base64 48
LEADS_MONITOR_KEK=

# Google Places API (oficial) — NUNCA no frontend.
# Nome da variável: GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_API_KEY=

# NX ERP / CRM — somente Functions / Secret Manager. Nunca VITE_*.
NX_ERP_ENABLED=true
NX_ERP_API_URL=https://nx-erp-disparo-nuvem.onrender.com
NX_ERP_API_KEY=
NX_ERP_TENANT_ID=
NX_ERP_HEALTH_PATH=/health
# POST /jobs da nuvem usa header X-Cloud-Token = CLOUD_SYNC_TOKEN (não commitar).
ERP_API_URL=
ERP_API_KEY=
CRM_API_URL=
CRM_API_KEY=

# Quando o projeto estiver no plano Blaze, migre para:
#   firebase functions:secrets:set GOOGLE_MAPS_API_KEY
#   firebase functions:secrets:set LEADS_MONITOR_KEK
#   firebase functions:secrets:set ERP_API_KEY
#   firebase functions:secrets:set CRM_API_KEY
#   firebase functions:secrets:set NX_ERP_API_KEY

# Meta WhatsApp Cloud API — somente Functions / Secret Manager. Nunca no frontend nem no git.
# Webhook público: https://southamerica-east1-recomece-cred-oficial.cloudfunctions.net/metaWhatsAppWebhook?empresaId=EMPRESA
META_APP_ID=
META_APP_SECRET=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=

