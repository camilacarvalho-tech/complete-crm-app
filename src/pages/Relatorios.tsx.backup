import { useState, useEffect } from 'react'
import { BarChart3, TrendingUp, Users, DollarSign, Calendar, Download, Filter, ArrowUp, ArrowDown } from 'lucide-react'
import { collection, query, onSnapshot, where, Timestamp } from 'firebase/firestore'
import { db } from '../firebase'
import { useTheme } from '../contexts/ThemeContext'

interface Cliente {
  id: string
  nome: string
  status: string
  modalidade?: string
  atendente?: string
  valorSolicitado?: string
  criadoEm: any
}

export default function Relatorios() {
  const [clientes, setClientes] = useState<Cliente[]>([])
  const [filtroData, setFiltroData] = useState('mes') // mes, semana, hoje, customizado
  const [dataInicio, setDataInicio] = useState('')
  const [dataFim, setDataFim] = useState('')
  const { darkMode } = useTheme()
  
  const empresaId = localStorage.getItem('empresaId') || 'default'

  useEffect(() => {
    const q = query(collection(db, 'empresas', empresaId, 'clientes'))
    const unsubscribe = onSnapshot(q, (snapshot) => {
      const clientesData = snapshot.docs.map((doc) => ({
        id: doc.id,
        ...doc.data()
      })) as Cliente[]
      setClientes(clientesData)
    })
    return () => unsubscribe()
  }, [empresaId])

  // Filtrar por data
  const clientesFiltrados = clientes.filter(cliente => {
    if (!cliente.criadoEm) return true
    
    const dataCliente = cliente.criadoEm.toDate ? cliente.criadoEm.toDate() : new Date(cliente.criadoEm)
    const hoje = new Date()
    
    if (filtroData === 'hoje') {
      return dataCliente.toDateString() === hoje.toDateString()
    } else if (filtroData === 'semana') {
      const umaSemanaAtras = new Date()
      umaSemanaAtras.setDate(hoje.getDate() - 7)
      return dataCliente >= umaSemanaAtras
    } else if (filtroData === 'mes') {
      const umMesAtras = new Date()
      umMesAtras.setMonth(hoje.getMonth() - 1)
      return dataCliente >= umMesAtras
    } else if (filtroData === 'customizado' && dataInicio && dataFim) {
      const inicio = new Date(dataInicio)
      const fim = new Date(dataFim)
      return dataCliente >= inicio && dataCliente <= fim
    }
    
    return true
  })

  // Métricas
  const totalClientes = clientesFiltrados.length
  const clientesNovos = clientesFiltrados.filter(c => {
    if (!c.criadoEm) return false
    const dataCliente = c.criadoEm.toDate ? c.criadoEm.toDate() : new Date(c.criadoEm)
    const seteDiasAtras = new Date()
    seteDiasAtras.setDate(new Date().getDate() - 7)
    return dataCliente >= seteDiasAtras
  }).length

  const contarPorStatus = (status: string) => {
    return clientesFiltrados.filter(c => c.status === status).length
  }

  const contarPorModalidade = (modalidade: string) => {
    return clientesFiltrados.filter(c => c.modalidade === modalidade).length
  }

  const calcularValorTotal = () => {
    return clientesFiltrados.reduce((total, cliente) => {
      const valor = parseFloat(cliente.valorSolicitado?.replace(/\D/g, '') || '0') / 100
      return total + valor
    }, 0)
  }

  const taxaConversao = totalClientes > 0 
    ? ((contarPorStatus('Aprovado') + contarPorStatus('Pago')) / totalClientes * 100).toFixed(1)
    : '0.0'

  const statusList = ['Lead', 'Em Atendimento', 'Proposta', 'Doc. Recebida', 'Análise Bancária', 'Aprovado', 'Pago', 'Sem Contato', 'Recusado', 'Remarketing']
  const modalidadesList = ['Antecipação FGTS', 'Crédito CLT', 'INSS', 'Conta de Energia', 'Refinanciamento Veículo', 'Placa Solar', 'SIAPE', 'Servidor Municipal']

  const statusColors: Record<string, string> = {
    'Lead': 'from-purple-500 to-purple-600',
    'Em Atendimento': 'from-blue-500 to-blue-600',
    'Proposta': 'from-yellow-500 to-yellow-600',
    'Doc. Recebida': 'from-cyan-500 to-cyan-600',
    'Análise Bancária': 'from-indigo-500 to-indigo-600',
    'Aprovado': 'from-green-500 to-green-600',
    'Pago': 'from-emerald-600 to-emerald-700',
    'Sem Contato': 'from-orange-500 to-orange-600',
    'Recusado': 'from-red-500 to-red-600',
    'Remarketing': 'from-pink-500 to-pink-600'
  }

  // Top Atendentes
  const rankingAtendentes = () => {
    const atendentes: Record<string, number> = {}
    clientesFiltrados.forEach(c => {
      if (c.atendente) {
        atendentes[c.atendente] = (atendentes[c.atendente] || 0) + 1
      }
    })
    return Object.entries(atendentes)
      .sort(([, a], [, b]) => b - a)
      .slice(0, 5)
  }

  // Origem do Tráfego
  const contarPorOrigem = () => {
    const origens: Record<string, number> = {}
    clientesFiltrados.forEach(c => {
      const origem = c.origem || 'Não informado'
      origens[origem] = (origens[origem] || 0) + 1
    })
    return Object.entries(origens).sort(([, a], [, b]) => b - a)
  }

  const coresOrigem = [
    '#8B5CF6', // roxo
    '#F59E0B', // laranja
    '#10B981', // verde
    '#EF4444', // vermelho
    '#3B82F6', // azul
    '#EC4899', // pink
    '#14B8A6', // teal
    '#6366F1'  // indigo
  ]

  return (
    <div>
      {/* Header */}
      <div className="flex items-center justify-between mb-8">
        <h1 className={`text-3xl font-bold flex items-center gap-3 ${
          darkMode ? 'text-white' : 'text-slate-800'
        }`}>
          <BarChart3 className="w-8 h-8 text-orange-500" />
          Relatórios e Análises
        </h1>
        
        <button className={`px-4 py-2 rounded-lg font-semibold transition flex items-center gap-2 ${
          darkMode 
            ? 'bg-slate-700 text-white hover:bg-slate-600' 
            : 'bg-slate-600 text-white hover:bg-slate-700'
        }`}>
          <Download className="w-5 h-5" />
          Exportar PDF
        </button>
      </div>

      {/* Filtros de Data */}
      <div className={`rounded-xl shadow-lg p-6 mb-6 ${
        darkMode ? 'bg-slate-800/80' : 'bg-white'
      }`}>
        <div className="flex items-center gap-2 mb-4">
          <Filter className={`w-5 h-5 ${darkMode ? 'text-slate-400' : 'text-slate-600'}`} />
          <h3 className={`text-lg font-bold ${darkMode ? 'text-white' : 'text-slate-800'}`}>
            Período
          </h3>
        </div>
        
        <div className="flex flex-wrap gap-3">
          <button
            onClick={() => setFiltroData('hoje')}
            className={`px-4 py-2 rounded-lg font-semibold transition ${
              filtroData === 'hoje'
                ? 'bg-gradient-to-r from-orange-500 to-blue-600 text-white shadow-lg'
                : darkMode
                ? 'bg-slate-700 text-slate-300 hover:bg-slate-600'
                : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
            }`}
          >
            Hoje
          </button>
          
          <button
            onClick={() => setFiltroData('semana')}
            className={`px-4 py-2 rounded-lg font-semibold transition ${
              filtroData === 'semana'
                ? 'bg-gradient-to-r from-orange-500 to-blue-600 text-white shadow-lg'
                : darkMode
                ? 'bg-slate-700 text-slate-300 hover:bg-slate-600'
                : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
            }`}
          >
            Última Semana
          </button>
          
          <button
            onClick={() => setFiltroData('mes')}
            className={`px-4 py-2 rounded-lg font-semibold transition ${
              filtroData === 'mes'
                ? 'bg-gradient-to-r from-orange-500 to-blue-600 text-white shadow-lg'
                : darkMode
                ? 'bg-slate-700 text-slate-300 hover:bg-slate-600'
                : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
            }`}
          >
            Último Mês
          </button>
          
          <button
            onClick={() => setFiltroData('customizado')}
            className={`px-4 py-2 rounded-lg font-semibold transition ${
              filtroData === 'customizado'
                ? 'bg-gradient-to-r from-orange-500 to-blue-600 text-white shadow-lg'
                : darkMode
                ? 'bg-slate-700 text-slate-300 hover:bg-slate-600'
                : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
            }`}
          >
            Personalizado
          </button>
          
          {filtroData === 'customizado' && (
            <div className="flex gap-2">
              <input
                type="date"
                value={dataInicio}
                onChange={(e) => setDataInicio(e.target.value)}
                className={`px-3 py-2 rounded-lg outline-none ${
                  darkMode 
                    ? 'bg-slate-700 border-slate-600 text-white border'
                    : 'bg-white border border-slate-300 text-slate-800'
                }`}
              />
              <span className={darkMode ? 'text-slate-400' : 'text-slate-600'}>até</span>
              <input
                type="date"
                value={dataFim}
                onChange={(e) => setDataFim(e.target.value)}
                className={`px-3 py-2 rounded-lg outline-none ${
                  darkMode 
                    ? 'bg-slate-700 border-slate-600 text-white border'
                    : 'bg-white border border-slate-300 text-slate-800'
                }`}
              />
            </div>
          )}
        </div>
      </div>

      {/* Cards de Métricas Principais */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
        {/* Total de Clientes */}
        <div className={`rounded-xl shadow-lg p-6 ${
          darkMode 
            ? 'bg-gradient-to-br from-purple-900/40 to-purple-800/40 ring-1 ring-purple-500/30' 
            : 'bg-gradient-to-br from-purple-50 to-purple-100'
        }`}>
          <div className="flex items-center justify-between mb-4">
            <Users className="w-10 h-10 text-purple-500" />
            <span className={`text-sm font-semibold px-2 py-1 rounded ${
              darkMode ? 'bg-purple-500/20 text-purple-300' : 'bg-purple-200 text-purple-700'
            }`}>
              Total
            </span>
          </div>
          <h3 className={`text-3xl font-bold mb-1 ${
            darkMode ? 'text-white' : 'text-slate-800'
          }`}>
            {totalClientes}
          </h3>
          <p className={`text-sm ${darkMode ? 'text-slate-400' : 'text-slate-600'}`}>
            Clientes no período
          </p>
        </div>

        {/* Clientes Novos */}
        <div className={`rounded-xl shadow-lg p-6 ${
          darkMode 
            ? 'bg-gradient-to-br from-blue-900/40 to-blue-800/40 ring-1 ring-blue-500/30' 
            : 'bg-gradient-to-br from-blue-50 to-blue-100'
        }`}>
          <div className="flex items-center justify-between mb-4">
            <TrendingUp className="w-10 h-10 text-blue-500" />
            <span className={`text-sm font-semibold px-2 py-1 rounded flex items-center gap-1 ${
              darkMode ? 'bg-blue-500/20 text-blue-300' : 'bg-blue-200 text-blue-700'
            }`}>
              <ArrowUp className="w-3 h-3" />
              7 dias
            </span>
          </div>
          <h3 className={`text-3xl font-bold mb-1 ${
            darkMode ? 'text-white' : 'text-slate-800'
          }`}>
            {clientesNovos}
          </h3>
          <p className={`text-sm ${darkMode ? 'text-slate-400' : 'text-slate-600'}`}>
            Novos clientes
          </p>
        </div>

        {/* Taxa de Conversão */}
        <div className={`rounded-xl shadow-lg p-6 ${
          darkMode 
            ? 'bg-gradient-to-br from-green-900/40 to-green-800/40 ring-1 ring-green-500/30' 
            : 'bg-gradient-to-br from-green-50 to-green-100'
        }`}>
          <div className="flex items-center justify-between mb-4">
            <BarChart3 className="w-10 h-10 text-green-500" />
            <span className={`text-sm font-semibold px-2 py-1 rounded ${
              darkMode ? 'bg-green-500/20 text-green-300' : 'bg-green-200 text-green-700'
            }`}>
              Conversão
            </span>
          </div>
          <h3 className={`text-3xl font-bold mb-1 ${
            darkMode ? 'text-white' : 'text-slate-800'
          }`}>
            {taxaConversao}%
          </h3>
          <p className={`text-sm ${darkMode ? 'text-slate-400' : 'text-slate-600'}`}>
            Aprovados + Pagos
          </p>
        </div>

        {/* Valor Total */}
        <div className={`rounded-xl shadow-lg p-6 ${
          darkMode 
            ? 'bg-gradient-to-br from-orange-900/40 to-orange-800/40 ring-1 ring-orange-500/30' 
            : 'bg-gradient-to-br from-orange-50 to-orange-100'
        }`}>
          <div className="flex items-center justify-between mb-4">
            <DollarSign className="w-10 h-10 text-orange-500" />
            <span className={`text-sm font-semibold px-2 py-1 rounded ${
              darkMode ? 'bg-orange-500/20 text-orange-300' : 'bg-orange-200 text-orange-700'
            }`}>
              Volume
            </span>
          </div>
          <h3 className={`text-3xl font-bold mb-1 ${
            darkMode ? 'text-white' : 'text-slate-800'
          }`}>
            R$ {calcularValorTotal().toLocaleString('pt-BR', { minimumFractionDigits: 2 })}
          </h3>
          <p className={`text-sm ${darkMode ? 'text-slate-400' : 'text-slate-600'}`}>
            Valor solicitado
          </p>
        </div>
      </div>

      {/* Gráficos */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        {/* Gráfico de Barras - Clientes por Status */}
        <div className={`rounded-xl shadow-lg p-6 ${
          darkMode ? 'bg-slate-800/80' : 'bg-white'
        }`}>
          <h3 className={`text-lg font-bold mb-6 ${
            darkMode ? 'text-white' : 'text-slate-800'
          }`}>
            📊 Clientes por Status
          </h3>
          
          <div className="h-64 flex items-end justify-between gap-2">
            {statusList.slice(0, 6).map(status => {
              const count = contarPorStatus(status)
              const maxCount = Math.max(...statusList.map(s => contarPorStatus(s)), 1)
              const height = (count / maxCount) * 100
              
              return (
                <div key={status} className="flex-1 flex flex-col items-center gap-2">
                  <div className="relative w-full flex flex-col items-center">
                    <span className={`text-xs font-bold mb-1 ${
                      darkMode ? 'text-white' : 'text-slate-800'
                    }`}>
                      {count}
                    </span>
                    <div
                      className={`w-full rounded-t-lg bg-gradient-to-t ${statusColors[status]} transition-all duration-500 hover:opacity-80 cursor-pointer`}
                      style={{ height: `${height > 0 ? Math.max(height, 10) : 0}%` }}
                      title={`${status}: ${count}`}
                    />
                  </div>
                  <span className={`text-[10px] text-center font-semibold leading-tight ${
                    darkMode ? 'text-slate-400' : 'text-slate-600'
                  }`}>
                    {status.split(' ').join('\n')}
                  </span>
                </div>
              )
            })}
          </div>
        </div>

        {/* Gráfico de Pizza - Origem do Tráfego */}
        <div className={`rounded-xl shadow-lg p-6 ${
          darkMode ? 'bg-slate-800/80' : 'bg-white'
        }`}>
          <h3 className={`text-lg font-bold mb-6 ${
            darkMode ? 'text-white' : 'text-slate-800'
          }`}>
            🎯 Origem do Tráfego
          </h3>
          
          <div className="flex items-center gap-8">
            {/* Pizza Chart */}
            <div className="relative w-48 h-48 flex-shrink-0">
              <svg viewBox="0 0 100 100" className="transform -rotate-90">
                {(() => {
                  const origens = contarPorOrigem()
                  let currentAngle = 0
                  
                  return origens.map(([origem, count], index) => {
                    const percent = (count / totalClientes) * 100
                    const angle = (percent / 100) * 360
                    const endAngle = currentAngle + angle
                    
                    const x1 = 50 + 45 * Math.cos((currentAngle * Math.PI) / 180)
                    const y1 = 50 + 45 * Math.sin((currentAngle * Math.PI) / 180)
                    const x2 = 50 + 45 * Math.cos((endAngle * Math.PI) / 180)
                    const y2 = 50 + 45 * Math.sin((endAngle * Math.PI) / 180)
                    
                    const largeArc = angle > 180 ? 1 : 0
                    
                    const path = [
                      `M 50 50`,
                      `L ${x1} ${y1}`,
                      `A 45 45 0 ${largeArc} 1 ${x2} ${y2}`,
                      `Z`
                    ].join(' ')
                    
                    currentAngle = endAngle
                    
                    return (
                      <path
                        key={origem}
                        d={path}
                        fill={coresOrigem[index % coresOrigem.length]}
                        className="hover:opacity-80 transition-opacity cursor-pointer"
                        title={`${origem}: ${count} (${percent.toFixed(1)}%)`}
                      />
                    )
                  })
                })()}
                
                {/* Centro branco */}
                <circle cx="50" cy="50" r="20" fill={darkMode ? '#1e293b' : '#ffffff'} />
              </svg>
              
              {/* Texto central */}
              <div className="absolute inset-0 flex flex-col items-center justify-center">
                <span className={`text-2xl font-bold ${
                  darkMode ? 'text-white' : 'text-slate-800'
                }`}>
                  {totalClientes}
                </span>
                <span className={`text-xs ${
                  darkMode ? 'text-slate-400' : 'text-slate-600'
                }`}>
                  Total
                </span>
              </div>
            </div>
            
            {/* Legenda */}
            <div className="flex-1 space-y-2">
              {contarPorOrigem().map(([origem, count], index) => {
                const percent = totalClientes > 0 ? ((count / totalClientes) * 100).toFixed(1) : '0.0'
                
                return (
                  <div key={origem} className="flex items-center justify-between">
                    <div className="flex items-center gap-2">
                      <div
                        className="w-3 h-3 rounded-full"
                        style={{ backgroundColor: coresOrigem[index % coresOrigem.length] }}
                      />
                      <span className={`text-sm font-semibold ${
                        darkMode ? 'text-slate-300' : 'text-slate-700'
                      }`}>
                        {origem}
                      </span>
                    </div>
                    <div className="flex items-center gap-2">
                      <span className={`text-sm font-bold ${
                        darkMode ? 'text-white' : 'text-slate-800'
                      }`}>
                        {count}
                      </span>
                      <span className={`text-xs ${
                        darkMode ? 'text-slate-400' : 'text-slate-600'
                      }`}>
                        {percent}%
                      </span>
                    </div>
                  </div>
                )
              })}
            </div>
          </div>
        </div>
      </div>

      {/* Funil de Vendas */}
      <div className={`rounded-xl shadow-lg p-6 mb-6 ${
        darkMode ? 'bg-slate-800/80' : 'bg-white'
      }`}>
        <h3 className={`text-lg font-bold mb-6 ${
          darkMode ? 'text-white' : 'text-slate-800'
        }`}>
          🔻 Funil de Vendas
        </h3>
        
        <div className="space-y-3">
          {[
            { label: 'Leads', status: 'Lead', color: 'from-purple-500 to-purple-600' },
            { label: 'Em Atendimento', status: 'Em Atendimento', color: 'from-blue-500 to-blue-600' },
            { label: 'Propostas', status: 'Proposta', color: 'from-yellow-500 to-yellow-600' },
            { label: 'Documentação', status: 'Doc. Recebida', color: 'from-cyan-500 to-cyan-600' },
            { label: 'Análise', status: 'Análise Bancária', color: 'from-indigo-500 to-indigo-600' },
            { label: 'Aprovados', status: 'Aprovado', color: 'from-green-500 to-green-600' },
            { label: 'Fechados', status: 'Pago', color: 'from-emerald-600 to-emerald-700' }
          ].map((stage, index) => {
            const count = contarPorStatus(stage.status)
            const percent = totalClientes > 0 ? (count / totalClientes * 100) : 0
            const width = Math.max(percent, 5) // Mínimo 5% para visibilidade
            
            return (
              <div key={stage.status} className="relative">
                <div className="flex items-center justify-between mb-2">
                  <span className={`text-sm font-bold ${
                    darkMode ? 'text-slate-300' : 'text-slate-700'
                  }`}>
                    {stage.label}
                  </span>
                  <span className={`text-sm font-bold ${
                    darkMode ? 'text-white' : 'text-slate-800'
                  }`}>
                    {count} ({percent.toFixed(1)}%)
                  </span>
                </div>
                
                <div className="relative">
                  <div className={`h-12 rounded-lg overflow-hidden ${
                    darkMode ? 'bg-slate-700/30' : 'bg-slate-100'
                  }`}>
                    <div
                      className={`h-full bg-gradient-to-r ${stage.color} transition-all duration-500 flex items-center justify-center`}
                      style={{ 
                        width: `${width}%`,
                        clipPath: `polygon(0 0, ${100 - (index * 2)}% 0, ${100 - ((index + 1) * 2)}% 100%, 0 100%)`
                      }}
                    >
                      <span className="text-white font-bold text-lg">{count}</span>
                    </div>
                  </div>
                </div>
              </div>
            )
          })}
        </div>
      </div>

      {/* Gráfico de Barras Horizontais - Distribuição por Status ANTIGO (mantido para comparação) */}
      <div className={`rounded-xl shadow-lg p-6 mb-6 ${
        darkMode ? 'bg-slate-800/80' : 'bg-white'
      }`}>
        <h3 className={`text-lg font-bold mb-6 ${
          darkMode ? 'text-white' : 'text-slate-800'
        }`}>
          📈 Distribuição Detalhada por Status
        </h3>
          
          <div className="space-y-3">
            {statusList.map(status => {
              const count = contarPorStatus(status)
              const percent = totalClientes > 0 ? (count / totalClientes * 100).toFixed(1) : '0.0'
              
              return (
                <div key={status}>
                  <div className="flex items-center justify-between mb-1">
                    <span className={`text-sm font-semibold ${
                      darkMode ? 'text-slate-300' : 'text-slate-700'
                    }`}>
                      {status}
                    </span>
                    <span className={`text-sm font-bold ${
                      darkMode ? 'text-white' : 'text-slate-800'
                    }`}>
                      {count} ({percent}%)
                    </span>
                  </div>
                  <div className={`h-2 rounded-full overflow-hidden ${
                    darkMode ? 'bg-slate-700' : 'bg-slate-200'
                  }`}>
                    <div
                      className={`h-full bg-gradient-to-r ${statusColors[status] || 'from-slate-500 to-slate-600'} transition-all`}
                      style={{ width: `${percent}%` }}
                    />
                  </div>
                </div>
              )
            })}
          </div>
        </div>

        {/* Modalidades */}
        <div className={`rounded-xl shadow-lg p-6 ${
          darkMode ? 'bg-slate-800/80' : 'bg-white'
        }`}>
          <h3 className={`text-lg font-bold mb-6 ${
            darkMode ? 'text-white' : 'text-slate-800'
          }`}>
            Modalidades Mais Procuradas
          </h3>
          
          <div className="space-y-3">
            {modalidadesList.map((modalidade, index) => {
              const count = contarPorModalidade(modalidade)
              const percent = totalClientes > 0 ? (count / totalClientes * 100).toFixed(1) : '0.0'
              const colors = [
                'from-blue-500 to-blue-600',
                'from-purple-500 to-purple-600',
                'from-pink-500 to-pink-600',
                'from-orange-500 to-orange-600',
                'from-green-500 to-green-600',
                'from-cyan-500 to-cyan-600',
                'from-indigo-500 to-indigo-600',
                'from-red-500 to-red-600'
              ]
              
              return (
                <div key={modalidade}>
                  <div className="flex items-center justify-between mb-1">
                    <span className={`text-sm font-semibold truncate ${
                      darkMode ? 'text-slate-300' : 'text-slate-700'
                    }`}>
                      {modalidade}
                    </span>
                    <span className={`text-sm font-bold ${
                      darkMode ? 'text-white' : 'text-slate-800'
                    }`}>
                      {count} ({percent}%)
                    </span>
                  </div>
                  <div className={`h-2 rounded-full overflow-hidden ${
                    darkMode ? 'bg-slate-700' : 'bg-slate-200'
                  }`}>
                    <div
                      className={`h-full bg-gradient-to-r ${colors[index]} transition-all`}
                      style={{ width: `${percent}%` }}
                    />
                  </div>
                </div>
              )
            })}
          </div>
        </div>
      </div>

      {/* Ranking de Atendentes */}
      <div className={`rounded-xl shadow-lg p-6 ${
        darkMode ? 'bg-slate-800/80' : 'bg-white'
      }`}>
        <h3 className={`text-lg font-bold mb-6 ${
          darkMode ? 'text-white' : 'text-slate-800'
        }`}>
          🏆 Top 5 Atendentes
        </h3>
        
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
          {rankingAtendentes().map(([atendente, count], index) => (
            <div
              key={atendente}
              className={`rounded-lg p-4 text-center ${
                index === 0
                  ? 'bg-gradient-to-br from-yellow-500/20 to-orange-500/20 ring-2 ring-yellow-500/50'
                  : darkMode
                  ? 'bg-slate-700/50'
                  : 'bg-slate-100'
              }`}
            >
              <div className={`text-3xl font-bold mb-2 ${
                index === 0 ? 'text-yellow-500' :
                index === 1 ? 'text-slate-400' :
                index === 2 ? 'text-orange-700' :
                darkMode ? 'text-slate-500' : 'text-slate-600'
              }`}>
                #{index + 1}
              </div>
              <div className={`font-bold text-lg mb-1 truncate ${
                darkMode ? 'text-white' : 'text-slate-800'
              }`}>
                {atendente}
              </div>
              <div className={`text-2xl font-bold ${
                darkMode ? 'text-blue-400' : 'text-blue-600'
              }`}>
                {count}
              </div>
              <div className={`text-xs ${
                darkMode ? 'text-slate-400' : 'text-slate-600'
              }`}>
                clientes
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}
