        </div>
      </div>

      {/* Abas de Nichos (igual Campanhas) */}
      <div className="bg-white dark:bg-slate-800 rounded-xl shadow-lg overflow-hidden mx-6 mt-4">
        {/* Primeira linha - Abas de Nichos */}
        <div className="border-b border-slate-200 dark:border-slate-700">
          <div className="relative flex items-center">
            {/* Botão Esquerda */}
            <button
