              💾 Salvar Configurações
            </button>
          </div>
        </div>
      </div>
    </div>
  )
}

// Aba Leads por Nicho
function AbaLeadsPorNicho({ nicho, total }: { nicho: string; total: number }) {
  // Define os dados mockados baseado no tipo de nicho
  const getNichoType = () => {
    if (nicho.includes('INSS') || nicho.includes('FGTS') || nicho.includes('CLT') || nicho.includes('Siape') || nicho.includes('Exército') || nicho.includes('Prefeituras')) {
      return 'correspondente'
    }
    if (nicho.includes('Odonto') || nicho.includes('Implantes') || nicho.includes('Ortodontia') || nicho.includes('Clareamento')) {
      return 'odonto'
    }
    if (nicho.includes('Clínica') || nicho.includes('Cardiologia') || nicho.includes('Ortopedia')) {
      return 'clinica'
    }
    if (nicho.includes('Psico') || nicho.includes('Terapia')) {
      return 'psico'
    }
    if (nicho.includes('Nutrição') || nicho.includes('Emagrecimento') || nicho.includes('Hipertrofia')) {
      return 'nutricao'
    }
    if (nicho.includes('Academia') || nicho.includes('Alunos') || nicho.includes('Musculação') || nicho.includes('CrossFit')) {
      return 'academia'
    }
    return 'geral'
  }

  const nichoType = getNichoType()

  // Dados para Correspondente Bancário
  const leadsCorrespondente = [
    { nome: 'João Silva Santos', cpf: '123.456.789-45', telefone: '(11) 98765-4321', margem: 3500, cidade: 'São Paulo', estado: 'SP', status: 'Novo' },
