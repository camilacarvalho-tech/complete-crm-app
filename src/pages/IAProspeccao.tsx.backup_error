        { id: 'pacientes', label: 'Buscar Pacientes', total: 312 },
        { id: 'convenios', label: 'Buscar Convênios', total: 25 },
        { id: 'cardiologia', label: 'Cardiologia', total: 98 },
        { id: 'ortopedia', label: 'Ortopedia', total: 76 },
