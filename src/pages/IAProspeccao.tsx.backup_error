              </svg>
            </button>

            <div id="nichos-scroll-ia" className="flex overflow-x-auto scrollbar-thin scrollbar-thumb-slate-300 dark:scrollbar-thumb-slate-600 px-12 scroll-smooth">
              {/* Dashboard */}
              <button
                onClick={() => {
                  setNichoSelecionado(null)
                  setProdutoSelecionado(null)
