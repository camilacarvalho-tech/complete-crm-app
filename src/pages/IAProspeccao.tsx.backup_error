        { id: 'terapia_casal', label: '🧠 Terapia Casal', total: 43, nicho: 'Psicologia' },
        
        // NUTRIÇÃO
        { id: 'pacientes_nutri', label: '🍎 Pacientes Nutrição', total: 203, nicho: 'Nutrição' },
        { id: 'emagrecimento', label: '🍎 Emagrecimento', total: 98, nicho: 'Nutrição' },
        { id: 'hipertrofia', label: '🍎 Hipertrofia', total: 65, nicho: 'Nutrição' },
        
        // ACADEMIA
        { id: 'alunos', label: '💪 Alunos Academia', total: 456, nicho: 'Academia' },
        { id: 'musculacao', label: '💪 Musculação', total: 234, nicho: 'Academia' },
        { id: 'crossfit', label: '💪 CrossFit', total: 89, nicho: 'Academia' }
      ]
    }
    
    // CORRESPONDENTE BANCÁRIO
    if (nicho === 'correspondente_bancario') {
      return [
        { id: 'inss', label: 'INSS', total: 127 },
        { id: 'fgts', label: 'Saque FGTS', total: 89 },
        { id: 'clt', label: 'Crédito CLT', total: 156 },
        { id: 'siape', label: 'Siape', total: 78 },
        { id: 'exercito', label: 'Exército', total: 34 },
        { id: 'prefeituras', label: 'Prefeituras', total: 45 }
      ]
    }
    
    // ODONTOLOGIA
    if (nicho === 'odontologia') {
      return [
        { id: 'pacientes', label: 'Buscar Pacientes', total: 245 },
        { id: 'convenios', label: 'Buscar Convênios', total: 18 },
        { id: 'implantes', label: 'Implantes', total: 87 },
        { id: 'ortodontia', label: 'Ortodontia', total: 134 },
        { id: 'clareamento', label: 'Clareamento', total: 92 }
      ]
    }
    
    // CLÍNICA MÉDICA
    if (nicho === 'clinica_medica') {
