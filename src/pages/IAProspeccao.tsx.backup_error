                </label>
              </div>
            ))}
          </div>

          {/* Informação de Ajuda */}
          <div className="mt-6 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4">
            <div className="flex gap-3">
              <div className="bg-blue-500 text-white rounded-full p-2 h-fit">
                <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div className="flex-1">
                <h4 className="font-bold text-blue-900 dark:text-blue-100 mb-1">
                  💡 Como funciona o Robô?
                </h4>
                <p className="text-sm text-blue-800 dark:text-blue-200">
                  O robô vai buscar automaticamente clientes que se encaixam nos produtos selecionados. 
                  Quando encontrar leads quentes, eles aparecem no <strong>Dashboard</strong> e são enviados 
                  automaticamente para <strong>Campanhas</strong> para você disparar WhatsApp, SMS ou Email!
                </p>
              </div>
            </div>
          </div>

          {/* Botão Salvar */}
          <div className="flex justify-end gap-3 pt-4 border-t border-slate-200 dark:border-slate-700">
