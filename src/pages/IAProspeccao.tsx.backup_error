        { id: 'pacientes', label: 'Buscar Pacientes', total: 203 },
        { id: 'convenios', label: 'Buscar Convênios', total: 15 },
        { id: 'emagrecimento', label: 'Emagrecimento', total: 98 },
        { id: 'hipertrofia', label: 'Hipertrofia', total: 65 },
        { id: 'gestantes', label: 'Gestantes', total: 34 }
