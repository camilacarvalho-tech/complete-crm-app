    { nome: 'Carlos Eduardo Alves', cpf: '789.123.456-34', telefone: '(71) 94321-0987', margem: 3900, cidade: 'Salvador', estado: 'BA', status: 'Novo' },
  ]

  // Dados para Odontologia
  const leadsOdonto = [
    { nome: 'Juliana Martins', cpf: '234.567.890-12', telefone: '(11) 99876-5432', procedimento: 'Implante Dentário', cidade: 'São Paulo', estado: 'SP', status: 'Interessado' },
    { nome: 'Roberto Carlos Silva', cpf: '345.678.901-23', telefone: '(21) 98765-4321', procedimento: 'Ortodontia', cidade: 'Rio de Janeiro', estado: 'RJ', status: 'Agendado' },
    { nome: 'Fernanda Lima', cpf: '456.789.012-34', telefone: '(31) 97654-3210', procedimento: 'Clareamento', cidade: 'Belo Horizonte', estado: 'MG', status: 'Novo' },
    { nome: 'Ricardo Gomes', cpf: '567.890.123-45', telefone: '(85) 96543-2109', procedimento: 'Limpeza', cidade: 'Fortaleza', estado: 'CE', status: 'Novo' },
    { nome: 'Patricia Santos', cpf: '678.901.234-56', telefone: '(71) 95432-1098', procedimento: 'Extração', cidade: 'Salvador', estado: 'BA', status: 'Interessado' },
  ]

  // Dados para Clínica Médica
  const leadsClinica = [
    { nome: 'Antonio Pereira', cpf: '789.012.345-67', telefone: '(11) 99988-7766', especialidade: 'Cardiologia', cidade: 'São Paulo', estado: 'SP', status: 'Agendado' },
    { nome: 'Beatriz Almeida', cpf: '890.123.456-78', telefone: '(21) 98877-6655', especialidade: 'Ortopedia', cidade: 'Rio de Janeiro', estado: 'RJ', status: 'Novo' },
    { nome: 'Claudio Ferreira', cpf: '901.234.567-89', telefone: '(31) 97766-5544', especialidade: 'Pediatria', cidade: 'Belo Horizonte', estado: 'MG', status: 'Novo' },
    { nome: 'Daniela Costa', cpf: '012.345.678-90', telefone: '(85) 96655-4433', especialidade: 'Ginecologia', cidade: 'Fortaleza', estado: 'CE', status: 'Interessado' },
    { nome: 'Eduardo Rocha', cpf: '123.456.789-01', telefone: '(71) 95544-3322', especialidade: 'Neurologia', cidade: 'Salvador', estado: 'BA', status: 'Agendado' },
  ]

  // Dados para Psicologia
  const leadsPsico = [
    { nome: 'Gabriela Mendes', cpf: '234.567.890-23', telefone: '(11) 99999-8888', tipo: 'Terapia Individual', cidade: 'São Paulo', estado: 'SP', status: 'Novo' },
    { nome: 'Henrique Barbosa', cpf: '345.678.901-34', telefone: '(21) 98888-7777', tipo: 'Terapia Casal', cidade: 'Rio de Janeiro', estado: 'RJ', status: 'Agendado' },
    { nome: 'Isabela Rodrigues', cpf: '456.789.012-45', telefone: '(31) 97777-6666', tipo: 'Terapia Infantil', cidade: 'Belo Horizonte', estado: 'MG', status: 'Novo' },
    { nome: 'Jorge Oliveira', cpf: '567.890.123-56', telefone: '(85) 96666-5555', tipo: 'Ansiedade', cidade: 'Fortaleza', estado: 'CE', status: 'Interessado' },
    { nome: 'Larissa Fernandes', cpf: '678.901.234-67', telefone: '(71) 95555-4444', tipo: 'Depressão', cidade: 'Salvador', estado: 'BA', status: 'Novo' },
  ]

  // Dados para Nutrição
  const leadsNutricao = [
    { nome: 'Marcos Vieira', cpf: '789.012.345-78', telefone: '(11) 99777-6666', objetivo: 'Emagrecimento', cidade: 'São Paulo', estado: 'SP', status: 'Novo' },
    { nome: 'Natalia Campos', cpf: '890.123.456-89', telefone: '(21) 98666-5555', objetivo: 'Hipertrofia', cidade: 'Rio de Janeiro', estado: 'RJ', status: 'Agendado' },
    { nome: 'Otavio Sousa', cpf: '901.234.567-90', telefone: '(31) 97555-4444', objetivo: 'Gestante', cidade: 'Belo Horizonte', estado: 'MG', status: 'Novo' },
    { nome: 'Paula Dias', cpf: '012.345.678-01', telefone: '(85) 96444-3333', objetivo: 'Diabetes', cidade: 'Fortaleza', estado: 'CE', status: 'Interessado' },
    { nome: 'Renato Pinto', cpf: '123.456.789-12', telefone: '(71) 95333-2222', objetivo: 'Colesterol Alto', cidade: 'Salvador', estado: 'BA', status: 'Novo' },
  ]

  // Dados para Academia
  const leadsAcademia = [
    { nome: 'Sofia Cardoso', cpf: '234.567.890-34', telefone: '(11) 99555-4444', plano: 'Musculação', cidade: 'São Paulo', estado: 'SP', status: 'Matriculado' },
    { nome: 'Thiago Moraes', cpf: '345.678.901-45', telefone: '(21) 98444-3333', plano: 'CrossFit', cidade: 'Rio de Janeiro', estado: 'RJ', status: 'Novo' },
    { nome: 'Ursula Freitas', cpf: '456.789.012-56', telefone: '(31) 97333-2222', plano: 'Pilates', cidade: 'Belo Horizonte', estado: 'MG', status: 'Novo' },
    { nome: 'Victor Hugo', cpf: '567.890.123-67', telefone: '(85) 96222-1111', plano: 'Personal Trainer', cidade: 'Fortaleza', estado: 'CE', status: 'Agendado' },
    { nome: 'Wanda Ribeiro', cpf: '678.901.234-78', telefone: '(71) 95111-0000', plano: 'Spinning', cidade: 'Salvador', estado: 'BA', status: 'Novo' },
  ]

  const leads = nichoType === 'correspondente' ? leadsCorrespondente :
                nichoType === 'odonto' ? leadsOdonto :
                nichoType === 'clinica' ? leadsClinica :
                nichoType === 'psico' ? leadsPsico :
                nichoType === 'nutricao' ? leadsNutricao :
                nichoType === 'academia' ? leadsAcademia : leadsCorrespondente

  const enviarParaCampanhas = () => {
    alert(`✅ ${total} leads de ${nicho} enviados para CAMPANHAS com sucesso!\n\nJá estão prontos para criar a campanha.`)
  }

  const enviarParaSMS = () => {
    alert(`✅ ${total} leads de ${nicho} enviados para SMS com sucesso!\n\nJá estão prontos para disparar mensagens.`)
  }

  const enviarTodosAutomatico = () => {
    alert(`🚀 AUTOMÁTICO ATIVADO!\n\n✅ ${total} leads enviados para CAMPANHAS\n✅ ${total} leads enviados para SMS\n✅ Disparos agendados automaticamente\n\nTudo pronto para trabalhar!`)
  }

  return (
    <div className="space-y-6">
      {/* Ações Rápidas */}
      <div className="bg-gradient-to-r from-purple-500 to-purple-600 rounded-xl p-6 text-white">
        <h2 className="text-2xl font-bold mb-2">Leads Encontrados: {nicho}</h2>
        <p className="mb-6 opacity-90">
