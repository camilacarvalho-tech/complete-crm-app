  const [tipoEnvio, setTipoEnvio] = useState<'agora' | 'agendar'>('agora')
  const [dataAgendamento, setDataAgendamento] = useState('')
  const [horaAgendamento, setHoraAgendamento] = useState('')
  
  // Função para abrir modal de envio
  const handleEnviarLeads = (nicho: string, total: number) => {
    setNichoSelecionadoEnvio(nicho)
    setLeadsCountEnvio(total)
    setShowModalEnvioRapido(true)
  }
  
  // Função para processar envio
  const handleProcessarEnvio = () => {
    // Aqui vamos criar a campanha automaticamente e redirecionar para Campanhas
    const campanhaData = {
      nicho: nichoSelecionadoEnvio,
      leads: leadsCountEnvio,
      canais: canaisEnvio,
      tipo: tipoEnvio,
      dataAgendamento: tipoEnvio === 'agendar' ? `${dataAgendamento} ${horaAgendamento}` : null,
      criadoEm: new Date().toISOString()
    }
    
    // Salvar no localStorage temporariamente (depois integrar com backend)
    localStorage.setItem('ultimaCampanha', JSON.stringify(campanhaData))
    
    // Redirecionar para Campanhas
    alert(`✅ Campanha criada com sucesso!\n\n📊 ${leadsCountEnvio} leads serão enviados via:\n${canaisEnvio.whatsapp ? '✅ WhatsApp\n' : ''}${canaisEnvio.sms ? '✅ SMS\n' : ''}${canaisEnvio.email ? '✅ E-mail\n' : ''}${canaisEnvio.voip ? '✅ VOIP/Discadora\n' : ''}\n\nRedirecionando para Campanhas...`)
    
    setShowModalEnvioRapido(false)
    
    // Redirecionar (quando tiver router implementado)
    // navigate('/campanhas')
  }
  
  // Define as abas baseado no nicho da empresa
  const getAbasPorNicho = () => {
    const nicho = empresa?.nicho
    const perfil = user?.perfil
    
    // MASTER vê TODAS as abas de TODOS os nichos
    if (perfil === 'master') {
      return [
        // CORRESPONDENTE BANCÁRIO
        { id: 'inss', label: '💰 INSS', total: 127, nicho: 'Correspondente' },
        { id: 'fgts', label: '💰 Saque FGTS', total: 89, nicho: 'Correspondente' },
        { id: 'clt', label: '💰 Crédito CLT', total: 156, nicho: 'Correspondente' },
