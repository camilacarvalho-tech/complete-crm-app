    leadsQuentes: leadsEncontrados,
    margemTotal: 2847500,
    taxaConversao: 34.5,
    roboAtivo: roboAtivo
  }

  const iniciarRobo = () => {
    setRoboAtivo(true)
    // Simula consultas automáticas
    const interval = setInterval(() => {
      setConsultasHoje(prev => prev + 1)
      if (Math.random() > 0.7) {
        setLeadsEncontrados(prev => prev + 1)
      }
    }, 3000)
    
    return () => clearInterval(interval)
  }

  const pararRobo = () => {
    setRoboAtivo(false)
  }

  return (
