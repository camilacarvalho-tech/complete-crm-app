                    onClick={() => setNichoSelecionado('correspondente_bancario')}
                    className={`flex-shrink-0 px-6 py-4 text-sm font-bold whitespace-nowrap border-b-2 transition-colors ${
                      nichoSelecionado === 'correspondente_bancario'
                        ? 'border-blue-500 text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/20'
                        : 'border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/50'
                    }`}
                  >
                    🏦 CORRESPONDENTE
                  </button>

                  {/* ODONTOLOGIA */}
                  <button
                    onClick={() => setNichoSelecionado('odontologia')}
                    className={`flex-shrink-0 px-6 py-4 text-sm font-bold whitespace-nowrap border-b-2 transition-colors ${
                      nichoSelecionado === 'odontologia'
                        ? 'border-teal-500 text-teal-600 dark:text-teal-400 bg-teal-50 dark:bg-teal-900/20'
                        : 'border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/50'
                    }`}
                  >
                    🦷 ODONTOLOGIA
                  </button>

                  {/* CLÍNICA MÉDICA */}
                  <button
                    onClick={() => setNichoSelecionado('clinica_medica')}
                    className={`flex-shrink-0 px-6 py-4 text-sm font-bold whitespace-nowrap border-b-2 transition-colors ${
                      nichoSelecionado === 'clinica_medica'
                        ? 'border-red-500 text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20'
                        : 'border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/50'
                    }`}
                  >
                    🏥 CLÍNICA MÉDICA
                  </button>

                  {/* PSICOLOGIA */}
                  <button
                    onClick={() => setNichoSelecionado('psicologia')}
                    className={`flex-shrink-0 px-6 py-4 text-sm font-bold whitespace-nowrap border-b-2 transition-colors ${
                      nichoSelecionado === 'psicologia'
                        ? 'border-purple-500 text-purple-600 dark:text-purple-400 bg-purple-50 dark:bg-purple-900/20'
                        : 'border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/50'
                    }`}
                  >
                    🧠 PSICOLOGIA
                  </button>

                  {/* NUTRIÇÃO */}
                  <button
                    onClick={() => setNichoSelecionado('nutricao')}
                    className={`flex-shrink-0 px-6 py-4 text-sm font-bold whitespace-nowrap border-b-2 transition-colors ${
                      nichoSelecionado === 'nutricao'
                        ? 'border-green-500 text-green-600 dark:text-green-400 bg-green-50 dark:bg-green-900/20'
                        : 'border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/50'
                    }`}
                  >
                    🥗 NUTRIÇÃO
                  </button>

                  {/* ACADEMIA */}
                  <button
                    onClick={() => setNichoSelecionado('academia')}
                    className={`flex-shrink-0 px-6 py-4 text-sm font-bold whitespace-nowrap border-b-2 transition-colors ${
                      nichoSelecionado === 'academia'
                        ? 'border-orange-500 text-orange-600 dark:text-orange-400 bg-orange-50 dark:bg-orange-900/20'
                        : 'border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/50'
                    }`}
                  >
                    💪 ACADEMIA
                  </button>
                </>
              )}

              {/* Se NÃO for MASTER, mostra APENAS o nicho da empresa */}
              {user?.perfil !== 'master' && empresa?.nicho && (
                <>
                  {empresa.nicho === 'correspondente_bancario' && (
                    <button
                      onClick={() => setNichoSelecionado('correspondente_bancario')}
                      className={`flex-shrink-0 px-6 py-4 text-sm font-bold whitespace-nowrap border-b-2 transition-colors ${
                        nichoSelecionado === 'correspondente_bancario'
                          ? 'border-blue-500 text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/20'
                          : 'border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/50'
                      }`}
                    >
                      🏦 CORRESPONDENTE
                    </button>
                  )}

                  {empresa.nicho === 'odontologia' && (
                    <button
                      onClick={() => setNichoSelecionado('odontologia')}
                      className={`flex-shrink-0 px-6 py-4 text-sm font-bold whitespace-nowrap border-b-2 transition-colors ${
                        nichoSelecionado === 'odontologia'
                          ? 'border-teal-500 text-teal-600 dark:text-teal-400 bg-teal-50 dark:bg-teal-900/20'
                          : 'border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/50'
                      }`}
                    >
                      🦷 ODONTOLOGIA
                    </button>
                  )}

                  {empresa.nicho === 'clinica_medica' && (
                    <button
                      onClick={() => setNichoSelecionado('clinica_medica')}
                      className={`flex-shrink-0 px-6 py-4 text-sm font-bold whitespace-nowrap border-b-2 transition-colors ${
                        nichoSelecionado === 'clinica_medica'
                          ? 'border-red-500 text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20'
                          : 'border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/50'
                      }`}
                    >
                      🏥 CLÍNICA MÉDICA
                    </button>
                  )}

                  {empresa.nicho === 'psicologia' && (
                    <button
                      onClick={() => setNichoSelecionado('psicologia')}
                      className={`flex-shrink-0 px-6 py-4 text-sm font-bold whitespace-nowrap border-b-2 transition-colors ${
                        nichoSelecionado === 'psicologia'
                          ? 'border-purple-500 text-purple-600 dark:text-purple-400 bg-purple-50 dark:bg-purple-900/20'
                          : 'border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/50'
                      }`}
                    >
                      🧠 PSICOLOGIA
                    </button>
                  )}

                  {empresa.nicho === 'nutricao' && (
                    <button
                      onClick={() => setNichoSelecionado('nutricao')}
                      className={`flex-shrink-0 px-6 py-4 text-sm font-bold whitespace-nowrap border-b-2 transition-colors ${
                        nichoSelecionado === 'nutricao'
                          ? 'border-green-500 text-green-600 dark:text-green-400 bg-green-50 dark:bg-green-900/20'
                          : 'border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/50'
                      }`}
                    >
                      🥗 NUTRIÇÃO
                    </button>
                  )}

                  {empresa.nicho === 'academia' && (
                    <button
                      onClick={() => setNichoSelecionado('academia')}
                      className={`flex-shrink-0 px-6 py-4 text-sm font-bold whitespace-nowrap border-b-2 transition-colors ${
                        nichoSelecionado === 'academia'
                          ? 'border-orange-500 text-orange-600 dark:text-orange-400 bg-orange-50 dark:bg-orange-900/20'
                          : 'border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/50'
                      }`}
                    >
                      💪 ACADEMIA
                    </button>
                  )}
                </>
              )}

              {/* Configurar */}
              <button
                onClick={() => {
                  setNichoSelecionado(null)
                  setProdutoSelecionado(null)
                  setAbaAtiva('configuracoes')
                }}
                className={`flex-shrink-0 px-6 py-4 text-sm font-bold whitespace-nowrap border-b-2 transition-colors ${
                  abaAtiva === 'configuracoes'
                    ? 'border-purple-500 text-purple-600 dark:text-purple-400 bg-purple-50 dark:bg-purple-900/20'
                    : 'border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/50'
                }`}
              >
                <Settings className="w-4 h-4 inline mr-2" />
                Configurar
              </button>
            </div>

            {/* Botão Direita */}
            <button
              onClick={() => {
                const container = document.getElementById('nichos-scroll-ia')
                if (container) container.scrollLeft += 200
              }}
              className="absolute right-2 z-10 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-full p-1.5 shadow-md hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors"
            >
              <svg className="w-3 h-3 text-slate-700 dark:text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>

        {/* Segunda linha - Sub-abas de Produtos */}
        {nichoSelecionado && (
          <div className="border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50">
            <div className="relative flex items-center">
              <button
                onClick={() => {
                  const container = document.getElementById('produtos-scroll-ia')
                  if (container) container.scrollLeft -= 200
                }}
                className="absolute left-2 z-10 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-full p-1.5 shadow-md hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors"
              >
                <svg className="w-3 h-3 text-slate-700 dark:text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 19l-7-7 7-7" />
                </svg>
              </button>

              <div 
                id="produtos-scroll-ia"
                className="flex overflow-x-auto scrollbar-thin scrollbar-thumb-slate-300 dark:scrollbar-thumb-slate-600 px-12 scroll-smooth"
              >
                {PRODUTOS_POR_NICHO[nichoSelecionado as keyof typeof PRODUTOS_POR_NICHO]?.map((produto) => (
                  <button
                    key={produto.id}
                    onClick={() => setProdutoSelecionado(produto.id)}
                    className={`flex-shrink-0 px-5 py-3 text-sm font-medium whitespace-nowrap border-b-2 transition-colors ${
                      produtoSelecionado === produto.id
                        ? 'border-orange-500 text-orange-600 dark:text-orange-400 bg-white dark:bg-slate-800'
                        : 'border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-white dark:hover:bg-slate-800'
                    }`}
                  >
                    {produto.nome}
                    <span className="ml-2 px-2 py-0.5 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full text-xs font-bold">
                      {produto.total}
                    </span>
                  </button>
                ))}
              </div>

              <button
                onClick={() => {
                  const container = document.getElementById('produtos-scroll-ia')
                  if (container) container.scrollLeft += 200
                }}
                className="absolute right-2 z-10 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-full p-1.5 shadow-md hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors"
              >
                <svg className="w-3 h-3 text-slate-700 dark:text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </div>
          </div>
        )}
      </div>

      {/* Abas antigas (manter por compatibilidade) */}
      <div className="hidden bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 overflow-x-auto">
        <div className="flex gap-1 p-2 min-w-max">
          <button
            onClick={() => setAbaAtiva('dashboard')}
            className={`px-6 py-3 rounded-lg font-medium transition-all whitespace-nowrap ${
              abaAtiva === 'configuracoes'
                ? 'bg-purple-500 text-white shadow-lg'
                : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700'
            }`}
          >
            <Settings className="w-4 h-4 inline mr-2" />
            Configurar
          </button>
        </div>
      </div>

      {/* Conteúdo das Abas */}
      <div className="flex-1 overflow-auto p-6">
        {abaAtiva === 'dashboard' && <AbaDashboard roboAtivo={roboAtivo} />}
        {abaAtiva === 'configuracoes' && <AbaConfigurarRobo />}
        {abaAtiva !== 'dashboard' && abaAtiva !== 'configuracoes' && (
          <AbaLeadsPorNicho 
            nicho={abas.find(a => a.id === abaAtiva)?.label || ''} 
            total={abas.find(a => a.id === abaAtiva)?.total || 0} 
          />
        )}
      </div>
    </div>
  )
}

// Aba Dashboard
function AbaDashboard({ roboAtivo }: { roboAtivo: boolean }) {
  // Leads simulados por nicho (depois virão do backend)
  const leadsPorNicho = {
    correspondente_bancario: [
      { produto: 'INSS', leads: 45, novos: 12, quentes: 8 },
      { produto: 'FGTS', leads: 32, novos: 7, quentes: 5 },
      { produto: 'CLT', leads: 58, novos: 15, quentes: 11 },
      { produto: 'Siape', leads: 28, novos: 6, quentes: 4 }
    ],
    odontologia: [
      { produto: 'Implantes', leads: 34, novos: 9, quentes: 6 },
      { produto: 'Ortodontia', leads: 52, novos: 14, quentes: 9 },
      { produto: 'Clareamento', leads: 41, novos: 11, quentes: 7 }
    ],
    clinica_medica: [
      { produto: 'Cardiologia', leads: 38, novos: 10, quentes: 7 },
      { produto: 'Ortopedia', leads: 29, novos: 8, quentes: 5 },
      { produto: 'Check-up', leads: 45, novos: 12, quentes: 8 }
    ],
    psicologia: [
      { produto: 'Terapia Individual', leads: 56, novos: 15, quentes: 10 },
      { produto: 'Terapia Casal', leads: 23, novos: 6, quentes: 4 }
    ],
    nutricao: [
      { produto: 'Emagrecimento', leads: 48, novos: 13, quentes: 9 },
      { produto: 'Hipertrofia', leads: 35, novos: 9, quentes: 6 }
    ],
    academia: [
      { produto: 'Musculação', leads: 67, novos: 18, quentes: 12 },
      { produto: 'CrossFit', leads: 42, novos: 11, quentes: 8 }
    ]
  }

  return (
    <div className="space-y-6">
      {/* Status do Robô */}
      <div className="bg-white dark:bg-slate-800 rounded-xl p-6 border border-slate-200 dark:border-slate-700">
        <h2 className="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-3">
          <Bot className="w-6 h-6 text-purple-500" />
          Status do Robô em Tempo Real
        </h2>
        {roboAtivo ? (
          <div className="space-y-4">
            <div className="flex items-center gap-3 text-green-600">
              <div className="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
              <span className="font-medium">Robô está ATIVO e buscando leads automaticamente...</span>
            </div>
            <div className="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg p-4">
              <p className="text-sm text-green-800 dark:text-green-200 leading-relaxed">
                ✓ Consultando bases de dados em tempo real<br/>
                ✓ Identificando clientes com perfil ideal<br/>
                ✓ Validando informações de contato<br/>
                ✓ Salvando leads automaticamente no CRM
              </p>
            </div>
          </div>
        ) : (
          <div className="text-center py-8">
            <Bot className="w-16 h-16 text-slate-300 dark:text-slate-600 mx-auto mb-4" />
            <p className="text-slate-600 dark:text-slate-400 mb-4">
              Robô está pausado. Clique em "Iniciar Robô" para começar a prospecção automática.
            </p>
          </div>
        )}
      </div>

      {/* Leads Encontrados por Nicho */}
      <div className="space-y-4">
        <div className="flex items-center justify-between">
          <h2 className="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-3">
            <Target className="w-6 h-6 text-orange-500" />
            Leads Encontrados por Nicho
          </h2>
          <button className="px-4 py-2 bg-gradient-to-r from-orange-500 to-red-500 text-white rounded-lg hover:shadow-lg transition-all text-sm font-medium">
            📤 Enviar TODOS para Campanhas
          </button>
        </div>

        {/* Cards de Nichos */}
        <div className="grid gap-4">
          {/* CORRESPONDENTE BANCÁRIO */}
          <div className="bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-900/20 dark:to-blue-800/20 rounded-xl border-2 border-blue-200 dark:border-blue-700 overflow-hidden">
            <div className="bg-blue-500 text-white px-6 py-3 flex items-center justify-between">
              <div className="flex items-center gap-3">
                <span className="text-2xl">🏦</span>
                <div>
                  <h3 className="font-bold text-lg">CORRESPONDENTE BANCÁRIO</h3>
                  <p className="text-xs opacity-90">Crédito consignado e produtos financeiros</p>
                </div>
              </div>
              <div className="flex items-center gap-4">
                <div className="text-right">
                  <div className="text-2xl font-bold">163</div>
                  <div className="text-xs opacity-90">leads totais</div>
                </div>
                <button 
                  onClick={() => handleEnviarLeads('CORRESPONDENTE BANCÁRIO', 163)}
                  className="px-4 py-2 bg-white text-blue-600 rounded-lg hover:bg-blue-50 transition-colors text-sm font-bold flex items-center gap-2"
                >
                  <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                  </svg>
                  Enviar
                </button>
              </div>
            </div>
            <div className="p-4 grid md:grid-cols-2 lg:grid-cols-4 gap-3">
              {leadsPorNicho.correspondente_bancario.map((item, idx) => (
                <div key={idx} className="bg-white dark:bg-slate-800 rounded-lg p-4 border border-blue-200 dark:border-blue-700">
                  <div className="font-semibold text-slate-900 dark:text-white mb-2">{item.produto}</div>
                  <div className="space-y-1 text-sm">
                    <div className="flex justify-between">
                      <span className="text-slate-600 dark:text-slate-400">Total:</span>
                      <span className="font-bold text-slate-900 dark:text-white">{item.leads}</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-slate-600 dark:text-slate-400">Novos:</span>
                      <span className="font-bold text-blue-600 dark:text-blue-400">{item.novos}</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-slate-600 dark:text-slate-400">Quentes:</span>
                      <span className="font-bold text-orange-600 dark:text-orange-400">🔥 {item.quentes}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* ODONTOLOGIA */}
          <div className="bg-gradient-to-br from-teal-50 to-teal-100 dark:from-teal-900/20 dark:to-teal-800/20 rounded-xl border-2 border-teal-200 dark:border-teal-700 overflow-hidden">
            <div className="bg-teal-500 text-white px-6 py-3 flex items-center justify-between">
              <div className="flex items-center gap-3">
                <span className="text-2xl">🦷</span>
                <div>
                  <h3 className="font-bold text-lg">ODONTOLOGIA</h3>
                  <p className="text-xs opacity-90">Tratamentos e procedimentos odontológicos</p>
                </div>
              </div>
              <div className="flex items-center gap-4">
                <div className="text-right">
                  <div className="text-2xl font-bold">127</div>
                  <div className="text-xs opacity-90">leads totais</div>
                </div>
                <button 
                  onClick={() => handleEnviarLeads('ODONTOLOGIA', 127)}
                  className="px-4 py-2 bg-white text-teal-600 rounded-lg hover:bg-teal-50 transition-colors text-sm font-bold flex items-center gap-2"
                >
                  <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                  </svg>
                  Enviar
                </button>
              </div>
            </div>
            <div className="p-4 grid md:grid-cols-2 lg:grid-cols-3 gap-3">
              {leadsPorNicho.odontologia.map((item, idx) => (
                <div key={idx} className="bg-white dark:bg-slate-800 rounded-lg p-4 border border-teal-200 dark:border-teal-700">
                  <div className="font-semibold text-slate-900 dark:text-white mb-2">{item.produto}</div>
                  <div className="space-y-1 text-sm">
                    <div className="flex justify-between">
                      <span className="text-slate-600 dark:text-slate-400">Total:</span>
                      <span className="font-bold text-slate-900 dark:text-white">{item.leads}</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-slate-600 dark:text-slate-400">Novos:</span>
                      <span className="font-bold text-teal-600 dark:text-teal-400">{item.novos}</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-slate-600 dark:text-slate-400">Quentes:</span>
                      <span className="font-bold text-orange-600 dark:text-orange-400">🔥 {item.quentes}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* CLÍNICA MÉDICA */}
          <div className="bg-gradient-to-br from-red-50 to-red-100 dark:from-red-900/20 dark:to-red-800/20 rounded-xl border-2 border-red-200 dark:border-red-700 overflow-hidden">
            <div className="bg-red-500 text-white px-6 py-3 flex items-center justify-between">
              <div className="flex items-center gap-3">
                <span className="text-2xl">🏥</span>
                <div>
                  <h3 className="font-bold text-lg">CLÍNICA MÉDICA</h3>
                  <p className="text-xs opacity-90">Consultas e especialidades médicas</p>
                </div>
              </div>
              <div className="flex items-center gap-4">
                <div className="text-right">
                  <div className="text-2xl font-bold">112</div>
                  <div className="text-xs opacity-90">leads totais</div>
                </div>
                <button 
                  onClick={() => handleEnviarLeads('CLÍNICA MÉDICA', 112)}
