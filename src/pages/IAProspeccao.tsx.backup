                    <p className="font-medium text-slate-900 dark:text-white">Crédito CLT</p>
                    <p className="text-xs text-slate-600 dark:text-slate-400">Trabalhadores com carteira assinada</p>
                  </div>
                </div>
                <label className="relative inline-flex items-center cursor-pointer">
