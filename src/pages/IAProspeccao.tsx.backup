                <div className="flex items-center gap-3">
                  <Database className="w-5 h-5 text-slate-600 dark:text-slate-400" />
                  <div>
                    <p className="font-medium text-slate-900 dark:text-white">Siape</p>
                    <p className="text-xs text-slate-600 dark:text-slate-400">Servidores públicos federais</p>
                  </div>
                </div>
                <label className="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" className="sr-only peer" defaultChecked />
                  <div className="w-14 h-7 bg-slate-300 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-green-300 dark:peer-focus:ring-green-800 rounded-full peer dark:bg-slate-600 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all dark:border-slate-600 peer-checked:bg-green-500"></div>
                </label>
              </div>

              {/* Exército */}
              <div className="flex items-center justify-between p-4 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg">
                <div className="flex items-center gap-3">
                  <Database className="w-5 h-5 text-slate-600 dark:text-slate-400" />
                  <div>
                    <p className="font-medium text-slate-900 dark:text-white">Exército</p>
                    <p className="text-xs text-slate-600 dark:text-slate-400">Militares das Forças Armadas</p>
                  </div>
                </div>
                <label className="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" className="sr-only peer" />
                  <div className="w-14 h-7 bg-slate-300 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-green-300 dark:peer-focus:ring-green-800 rounded-full peer dark:bg-slate-600 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all dark:border-slate-600 peer-checked:bg-green-500"></div>
                </label>
              </div>

              {/* Prefeituras */}
              <div className="flex items-center justify-between p-4 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg">
                <div className="flex items-center gap-3">
                  <Database className="w-5 h-5 text-slate-600 dark:text-slate-400" />
                  <div>
                    <p className="font-medium text-slate-900 dark:text-white">Prefeituras</p>
                    <p className="text-xs text-slate-600 dark:text-slate-400">Servidores municipais</p>
                  </div>
                </div>
                <label className="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" className="sr-only peer" />
                  <div className="w-14 h-7 bg-slate-300 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-green-300 dark:peer-focus:ring-green-800 rounded-full peer dark:bg-slate-600 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all dark:border-slate-600 peer-checked:bg-green-500"></div>
                </label>
              </div>
            </div>
          </div>

          {/* Configurações de Consulta */}
          <div>
            <h3 className="font-semibold text-slate-900 dark:text-white mb-3">Parâmetros de Busca</h3>
            <div className="space-y-3">
              <div>
                <label className="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                  Margem Mínima para Considerar Lead Quente
                </label>
                <input
                  type="number"
                  defaultValue={500}
                  className="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-purple-500 bg-white dark:bg-slate-700 text-slate-900 dark:text-white"
                  placeholder="R$ 500,00"
                />
              </div>

              <div>
                <label className="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                  Estados para Buscar
                </label>
                <select className="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-purple-500 bg-white dark:bg-slate-700 text-slate-900 dark:text-white">
                  <option>Todos os Estados do Brasil</option>
                  <optgroup label="Região Norte">
                    <option>AC - Acre</option>
                    <option>AP - Amapá</option>
                    <option>AM - Amazonas</option>
                    <option>PA - Pará</option>
                    <option>RO - Rondônia</option>
                    <option>RR - Roraima</option>
                    <option>TO - Tocantins</option>
                  </optgroup>
                  <optgroup label="Região Nordeste">
                    <option>AL - Alagoas</option>
                    <option>BA - Bahia</option>
                    <option>CE - Ceará</option>
                    <option>MA - Maranhão</option>
                    <option>PB - Paraíba</option>
                    <option>PE - Pernambuco</option>
                    <option>PI - Piauí</option>
                    <option>RN - Rio Grande do Norte</option>
                    <option>SE - Sergipe</option>
                  </optgroup>
                  <optgroup label="Região Centro-Oeste">
                    <option>DF - Distrito Federal</option>
                    <option>GO - Goiás</option>
                    <option>MT - Mato Grosso</option>
                    <option>MS - Mato Grosso do Sul</option>
                  </optgroup>
                  <optgroup label="Região Sudeste">
                    <option>ES - Espírito Santo</option>
                    <option>MG - Minas Gerais</option>
                    <option>RJ - Rio de Janeiro</option>
                    <option>SP - São Paulo</option>
                  </optgroup>
                  <optgroup label="Região Sul">
                    <option>PR - Paraná</option>
                    <option>RS - Rio Grande do Sul</option>
                    <option>SC - Santa Catarina</option>
                  </optgroup>
                </select>
              </div>

              <div>
                <label className="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                  Intervalo entre Consultas (segundos)
                </label>
                <input
                  type="number"
                  defaultValue={3}
                  className="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-purple-500 bg-white dark:bg-slate-700 text-slate-900 dark:text-white"
                />
              </div>
            </div>
          </div>

          <button className="w-full px-6 py-3 bg-gradient-to-r from-purple-500 to-purple-600 text-white rounded-lg hover:from-purple-600 hover:to-purple-700 transition-all font-medium">
            Salvar Configurações
          </button>
        </div>
      </div>
    </div>
  )
}

// Aba Leads por Nicho
function AbaLeadsPorNicho({ nicho, total }: { nicho: string; total: number }) {
  // Define os dados mockados baseado no tipo de nicho
  const getNichoType = () => {
    if (nicho.includes('INSS') || nicho.includes('FGTS') || nicho.includes('CLT') || nicho.includes('Siape') || nicho.includes('Exército') || nicho.includes('Prefeituras')) {
      return 'correspondente'
    }
    if (nicho.includes('Odonto') || nicho.includes('Implantes') || nicho.includes('Ortodontia') || nicho.includes('Clareamento')) {
      return 'odonto'
    }
    if (nicho.includes('Clínica') || nicho.includes('Cardiologia') || nicho.includes('Ortopedia')) {
      return 'clinica'
    }
    if (nicho.includes('Psico') || nicho.includes('Terapia')) {
      return 'psico'
    }
    if (nicho.includes('Nutrição') || nicho.includes('Emagrecimento') || nicho.includes('Hipertrofia')) {
      return 'nutricao'
    }
    if (nicho.includes('Academia') || nicho.includes('Alunos') || nicho.includes('Musculação') || nicho.includes('CrossFit')) {
      return 'academia'
    }
    return 'geral'
  }

  const nichoType = getNichoType()

  // Dados para Correspondente Bancário
  const leadsCorrespondente = [
    { nome: 'João Silva Santos', cpf: '123.456.789-45', telefone: '(11) 98765-4321', margem: 3500, cidade: 'São Paulo', estado: 'SP', status: 'Novo' },
    { nome: 'Maria Oliveira Costa', cpf: '987.654.321-67', telefone: '(21) 97654-3210', margem: 2800, cidade: 'Rio de Janeiro', estado: 'RJ', status: 'Novo' },
    { nome: 'Pedro Henrique Lima', cpf: '456.789.123-89', telefone: '(31) 96543-2109', margem: 4200, cidade: 'Belo Horizonte', estado: 'MG', status: 'Novo' },
    { nome: 'Ana Carolina Souza', cpf: '321.654.987-12', telefone: '(85) 95432-1098', margem: 5100, cidade: 'Fortaleza', estado: 'CE', status: 'Novo' },
    { nome: 'Carlos Eduardo Alves', cpf: '789.123.456-34', telefone: '(71) 94321-0987', margem: 3900, cidade: 'Salvador', estado: 'BA', status: 'Novo' },
  ]

  // Dados para Odontologia
  const leadsOdonto = [
    { nome: 'Juliana Martins', cpf: '234.567.890-12', telefone: '(11) 99876-5432', procedimento: 'Implante Dentário', cidade: 'São Paulo', estado: 'SP', status: 'Interessado' },
    { nome: 'Roberto Carlos Silva', cpf: '345.678.901-23', telefone: '(21) 98765-4321', procedimento: 'Ortodontia', cidade: 'Rio de Janeiro', estado: 'RJ', status: 'Agendado' },
    { nome: 'Fernanda Lima', cpf: '456.789.012-34', telefone: '(31) 97654-3210', procedimento: 'Clareamento', cidade: 'Belo Horizonte', estado: 'MG', status: 'Novo' },
    { nome: 'Ricardo Gomes', cpf: '567.890.123-45', telefone: '(85) 96543-2109', procedimento: 'Limpeza', cidade: 'Fortaleza', estado: 'CE', status: 'Novo' },
    { nome: 'Patricia Santos', cpf: '678.901.234-56', telefone: '(71) 95432-1098', procedimento: 'Extração', cidade: 'Salvador', estado: 'BA', status: 'Interessado' },
  ]

  // Dados para Clínica Médica
  const leadsClinica = [
    { nome: 'Antonio Pereira', cpf: '789.012.345-67', telefone: '(11) 99988-7766', especialidade: 'Cardiologia', cidade: 'São Paulo', estado: 'SP', status: 'Agendado' },
    { nome: 'Beatriz Almeida', cpf: '890.123.456-78', telefone: '(21) 98877-6655', especialidade: 'Ortopedia', cidade: 'Rio de Janeiro', estado: 'RJ', status: 'Novo' },
    { nome: 'Claudio Ferreira', cpf: '901.234.567-89', telefone: '(31) 97766-5544', especialidade: 'Pediatria', cidade: 'Belo Horizonte', estado: 'MG', status: 'Novo' },
    { nome: 'Daniela Costa', cpf: '012.345.678-90', telefone: '(85) 96655-4433', especialidade: 'Ginecologia', cidade: 'Fortaleza', estado: 'CE', status: 'Interessado' },
    { nome: 'Eduardo Rocha', cpf: '123.456.789-01', telefone: '(71) 95544-3322', especialidade: 'Neurologia', cidade: 'Salvador', estado: 'BA', status: 'Agendado' },
  ]

  // Dados para Psicologia
  const leadsPsico = [
    { nome: 'Gabriela Mendes', cpf: '234.567.890-23', telefone: '(11) 99999-8888', tipo: 'Terapia Individual', cidade: 'São Paulo', estado: 'SP', status: 'Novo' },
    { nome: 'Henrique Barbosa', cpf: '345.678.901-34', telefone: '(21) 98888-7777', tipo: 'Terapia Casal', cidade: 'Rio de Janeiro', estado: 'RJ', status: 'Agendado' },
    { nome: 'Isabela Rodrigues', cpf: '456.789.012-45', telefone: '(31) 97777-6666', tipo: 'Terapia Infantil', cidade: 'Belo Horizonte', estado: 'MG', status: 'Novo' },
    { nome: 'Jorge Oliveira', cpf: '567.890.123-56', telefone: '(85) 96666-5555', tipo: 'Ansiedade', cidade: 'Fortaleza', estado: 'CE', status: 'Interessado' },
    { nome: 'Larissa Fernandes', cpf: '678.901.234-67', telefone: '(71) 95555-4444', tipo: 'Depressão', cidade: 'Salvador', estado: 'BA', status: 'Novo' },
  ]

  // Dados para Nutrição
  const leadsNutricao = [
    { nome: 'Marcos Vieira', cpf: '789.012.345-78', telefone: '(11) 99777-6666', objetivo: 'Emagrecimento', cidade: 'São Paulo', estado: 'SP', status: 'Novo' },
    { nome: 'Natalia Campos', cpf: '890.123.456-89', telefone: '(21) 98666-5555', objetivo: 'Hipertrofia', cidade: 'Rio de Janeiro', estado: 'RJ', status: 'Agendado' },
    { nome: 'Otavio Sousa', cpf: '901.234.567-90', telefone: '(31) 97555-4444', objetivo: 'Gestante', cidade: 'Belo Horizonte', estado: 'MG', status: 'Novo' },
    { nome: 'Paula Dias', cpf: '012.345.678-01', telefone: '(85) 96444-3333', objetivo: 'Diabetes', cidade: 'Fortaleza', estado: 'CE', status: 'Interessado' },
    { nome: 'Renato Pinto', cpf: '123.456.789-12', telefone: '(71) 95333-2222', objetivo: 'Colesterol Alto', cidade: 'Salvador', estado: 'BA', status: 'Novo' },
  ]

  // Dados para Academia
  const leadsAcademia = [
    { nome: 'Sofia Cardoso', cpf: '234.567.890-34', telefone: '(11) 99555-4444', plano: 'Musculação', cidade: 'São Paulo', estado: 'SP', status: 'Matriculado' },
    { nome: 'Thiago Moraes', cpf: '345.678.901-45', telefone: '(21) 98444-3333', plano: 'CrossFit', cidade: 'Rio de Janeiro', estado: 'RJ', status: 'Novo' },
    { nome: 'Ursula Freitas', cpf: '456.789.012-56', telefone: '(31) 97333-2222', plano: 'Pilates', cidade: 'Belo Horizonte', estado: 'MG', status: 'Novo' },
    { nome: 'Victor Hugo', cpf: '567.890.123-67', telefone: '(85) 96222-1111', plano: 'Personal Trainer', cidade: 'Fortaleza', estado: 'CE', status: 'Agendado' },
    { nome: 'Wanda Ribeiro', cpf: '678.901.234-78', telefone: '(71) 95111-0000', plano: 'Spinning', cidade: 'Salvador', estado: 'BA', status: 'Novo' },
  ]

  const leads = nichoType === 'correspondente' ? leadsCorrespondente :
                nichoType === 'odonto' ? leadsOdonto :
                nichoType === 'clinica' ? leadsClinica :
                nichoType === 'psico' ? leadsPsico :
                nichoType === 'nutricao' ? leadsNutricao :
                nichoType === 'academia' ? leadsAcademia : leadsCorrespondente

  const enviarParaCampanhas = () => {
    alert(`✅ ${total} leads de ${nicho} enviados para CAMPANHAS com sucesso!\n\nJá estão prontos para criar a campanha.`)
  }

  const enviarParaSMS = () => {
    alert(`✅ ${total} leads de ${nicho} enviados para SMS com sucesso!\n\nJá estão prontos para disparar mensagens.`)
  }

  const enviarTodosAutomatico = () => {
    alert(`🚀 AUTOMÁTICO ATIVADO!\n\n✅ ${total} leads enviados para CAMPANHAS\n✅ ${total} leads enviados para SMS\n✅ Disparos agendados automaticamente\n\nTudo pronto para trabalhar!`)
  }

  return (
    <div className="space-y-6">
      {/* Ações Rápidas */}
      <div className="bg-gradient-to-r from-purple-500 to-purple-600 rounded-xl p-6 text-white">
        <h2 className="text-2xl font-bold mb-2">Leads Encontrados: {nicho}</h2>
        <p className="mb-6 opacity-90">
          O robô encontrou <strong>{total} leads quentes</strong> em {nicho}
        </p>
        <div className="grid md:grid-cols-3 gap-4">
          <button
            onClick={enviarParaCampanhas}
            className="bg-white text-purple-600 px-6 py-4 rounded-lg hover:bg-purple-50 transition-all font-semibold flex items-center justify-center gap-2"
          >
            <Target className="w-5 h-5" />
            Enviar para Campanhas
          </button>
          <button
            onClick={enviarParaSMS}
            className="bg-white text-purple-600 px-6 py-4 rounded-lg hover:bg-purple-50 transition-all font-semibold flex items-center justify-center gap-2"
          >
            <MessageSquare className="w-5 h-5" />
            Enviar para SMS
          </button>
          <button
            onClick={enviarTodosAutomatico}
            className="bg-green-500 text-white px-6 py-4 rounded-lg hover:bg-green-600 transition-all font-semibold flex items-center justify-center gap-2 shadow-lg"
          >
            <Zap className="w-5 h-5" />
            ENVIAR TUDO AUTOMÁTICO
          </button>
        </div>
      </div>

      {/* Tabela de Leads */}
      <div className="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden">
        <div className="p-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
          <h3 className="text-lg font-bold text-slate-900 dark:text-white">
            Lista de Leads - {nicho}
          </h3>
          <button className="px-4 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600 transition-colors flex items-center gap-2">
            <Download className="w-4 h-4" />
            Exportar Excel
          </button>
        </div>
        
        <div className="overflow-x-auto">
          <table className="w-full">
            <thead className="bg-slate-50 dark:bg-slate-700">
              <tr>
                <th className="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase">Nome Completo</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase">CPF</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase">Telefone</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase">Cidade/Estado</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase">
                  {nichoType === 'correspondente' ? 'Margem' : 
                   nichoType === 'odonto' ? 'Procedimento' :
                   nichoType === 'clinica' ? 'Especialidade' :
                   nichoType === 'psico' ? 'Tipo Terapia' :
                   nichoType === 'nutricao' ? 'Objetivo' :
                   nichoType === 'academia' ? 'Plano' : 'Info'}
                </th>
                <th className="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase">Status</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase">Ações</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-200 dark:divide-slate-700">
              {leads.map((lead: any, index) => (
                <tr key={index} className="hover:bg-slate-50 dark:hover:bg-slate-700/50">
                  <td className="px-6 py-4 text-sm font-medium text-slate-900 dark:text-white">{lead.nome}</td>
                  <td className="px-6 py-4 text-sm text-slate-700 dark:text-slate-300">{lead.cpf}</td>
                  <td className="px-6 py-4 text-sm text-slate-700 dark:text-slate-300">{lead.telefone}</td>
                  <td className="px-6 py-4 text-sm text-slate-700 dark:text-slate-300">{lead.cidade}/{lead.estado}</td>
                  <td className="px-6 py-4 text-sm">
                    {nichoType === 'correspondente' ? (
                      <span className="font-semibold text-green-600">R$ {lead.margem?.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}</span>
                    ) : (
                      <span className="px-2 py-1 bg-purple-100 text-purple-700 rounded text-xs font-medium">
                        {lead.procedimento || lead.especialidade || lead.tipo || lead.objetivo || lead.plano}
                      </span>
                    )}
                  </td>
                  <td className="px-6 py-4">
                    <span className="px-2 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-700">
                      {lead.status}
                    </span>
                  </td>
                  <td className="px-6 py-4">
                    <div className="flex gap-2">
                      <button className="p-2 text-green-600 hover:bg-green-50 dark:hover:bg-green-900/20 rounded-lg transition-colors" title="WhatsApp">
                        <MessageSquare className="w-4 h-4" />
                      </button>
                      <button className="p-2 text-blue-600 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded-lg transition-colors" title="Proposta">
                        <FileText className="w-4 h-4" />
                      </button>
                      <button className="p-2 text-purple-600 hover:bg-purple-50 dark:hover:bg-purple-900/20 rounded-lg transition-colors" title="Ver Detalhes">
                        <Eye className="w-4 h-4" />
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div className="p-4 bg-slate-50 dark:bg-slate-700 border-t border-slate-200 dark:border-slate-600 text-center text-sm text-slate-600 dark:text-slate-400">
          Mostrando 5 de {total} leads encontrados
        </div>
      </div>
    </div>
  )
}

