import { useState, useEffect } from 'react'
import { 
  Bot, Search, TrendingUp, Users, DollarSign, 
  CheckCircle, XCircle, Clock, AlertCircle,
  Upload, Download, Filter, Phone, MessageSquare,
  FileText, Play, Pause, BarChart3, Zap,
  Target, Eye, RefreshCw, Plus, Settings,
  Database, Activity, Shield
} from 'lucide-react'
import { useAuth } from '../contexts/AuthContext'

export default function IAProspeccao() {
  const { user, empresa } = useAuth()
  
  // Define as abas baseado no nicho da empresa
  const getAbasPorNicho = () => {
    const nicho = empresa?.nicho
    const perfil = user?.perfil
    
    // MASTER vê TODAS as abas de TODOS os nichos
    if (perfil === 'master') {
      return [
        // CORRESPONDENTE BANCÁRIO
        { id: 'inss', label: '💰 INSS', total: 127, nicho: 'Correspondente' },
        { id: 'fgts', label: '💰 Saque FGTS', total: 89, nicho: 'Correspondente' },
        { id: 'clt', label: '💰 Crédito CLT', total: 156, nicho: 'Correspondente' },
        { id: 'siape', label: '💰 Siape', total: 78, nicho: 'Correspondente' },
        { id: 'exercito', label: '💰 Exército', total: 34, nicho: 'Correspondente' },
        { id: 'prefeituras', label: '💰 Prefeituras', total: 45, nicho: 'Correspondente' },
        
        // ODONTOLOGIA
        { id: 'pacientes_odonto', label: '🦷 Pacientes Odonto', total: 245, nicho: 'Odontologia' },
        { id: 'convenios_odonto', label: '🦷 Convênios Odonto', total: 18, nicho: 'Odontologia' },
        { id: 'implantes', label: '🦷 Implantes', total: 87, nicho: 'Odontologia' },
        { id: 'ortodontia', label: '🦷 Ortodontia', total: 134, nicho: 'Odontologia' },
        { id: 'clareamento', label: '🦷 Clareamento', total: 92, nicho: 'Odontologia' },
        
        // CLÍNICA MÉDICA
        { id: 'pacientes_clinica', label: '🏥 Pacientes Clínica', total: 312, nicho: 'Clínica' },
        { id: 'convenios_clinica', label: '🏥 Convênios Clínica', total: 25, nicho: 'Clínica' },
        { id: 'cardiologia', label: '🏥 Cardiologia', total: 98, nicho: 'Clínica' },
        { id: 'ortopedia', label: '🏥 Ortopedia', total: 76, nicho: 'Clínica' },
        
        // PSICOLOGIA
        { id: 'pacientes_psico', label: '🧠 Pacientes Psico', total: 189, nicho: 'Psicologia' },
        { id: 'terapia_individual', label: '🧠 Terapia Individual', total: 112, nicho: 'Psicologia' },
        { id: 'terapia_casal', label: '🧠 Terapia Casal', total: 43, nicho: 'Psicologia' },
        
        // NUTRIÇÃO
        { id: 'pacientes_nutri', label: '🍎 Pacientes Nutrição', total: 203, nicho: 'Nutrição' },
        { id: 'emagrecimento', label: '🍎 Emagrecimento', total: 98, nicho: 'Nutrição' },
        { id: 'hipertrofia', label: '🍎 Hipertrofia', total: 65, nicho: 'Nutrição' },
        
        // ACADEMIA
        { id: 'alunos', label: '💪 Alunos Academia', total: 456, nicho: 'Academia' },
        { id: 'musculacao', label: '💪 Musculação', total: 234, nicho: 'Academia' },
        { id: 'crossfit', label: '💪 CrossFit', total: 89, nicho: 'Academia' }
      ]
    }
    
    // CORRESPONDENTE BANCÁRIO
    if (nicho === 'correspondente_bancario') {
      return [
        { id: 'inss', label: 'INSS', total: 127 },
        { id: 'fgts', label: 'Saque FGTS', total: 89 },
        { id: 'clt', label: 'Crédito CLT', total: 156 },
        { id: 'siape', label: 'Siape', total: 78 },
        { id: 'exercito', label: 'Exército', total: 34 },
        { id: 'prefeituras', label: 'Prefeituras', total: 45 }
      ]
    }
    
    // ODONTOLOGIA
    if (nicho === 'odontologia') {
      return [
        { id: 'pacientes', label: 'Buscar Pacientes', total: 245 },
        { id: 'convenios', label: 'Buscar Convênios', total: 18 },
        { id: 'implantes', label: 'Implantes', total: 87 },
        { id: 'ortodontia', label: 'Ortodontia', total: 134 },
        { id: 'clareamento', label: 'Clareamento', total: 92 }
      ]
    }
    
    // CLÍNICA MÉDICA
    if (nicho === 'clinica_medica') {
      return [
        { id: 'pacientes', label: 'Buscar Pacientes', total: 312 },
        { id: 'convenios', label: 'Buscar Convênios', total: 25 },
        { id: 'cardiologia', label: 'Cardiologia', total: 98 },
        { id: 'ortopedia', label: 'Ortopedia', total: 76 },
        { id: 'pediatria', label: 'Pediatria', total: 145 }
      ]
    }
    
    // PSICOLOGIA
    if (nicho === 'psicologia') {
      return [
        { id: 'pacientes', label: 'Buscar Pacientes', total: 189 },
        { id: 'convenios', label: 'Buscar Convênios', total: 12 },
        { id: 'terapia_individual', label: 'Terapia Individual', total: 112 },
        { id: 'terapia_casal', label: 'Terapia Casal', total: 43 },
        { id: 'terapia_infantil', label: 'Terapia Infantil', total: 67 }
      ]
    }
    
    // NUTRIÇÃO
    if (nicho === 'nutricao') {
      return [
        { id: 'pacientes', label: 'Buscar Pacientes', total: 203 },
        { id: 'convenios', label: 'Buscar Convênios', total: 15 },
        { id: 'emagrecimento', label: 'Emagrecimento', total: 98 },
        { id: 'hipertrofia', label: 'Hipertrofia', total: 65 },
        { id: 'gestantes', label: 'Gestantes', total: 34 }
      ]
    }
    
    // ACADEMIA
    if (nicho === 'academia') {
      return [
        { id: 'alunos', label: 'Buscar Alunos', total: 456 },
        { id: 'musculacao', label: 'Musculação', total: 234 },
        { id: 'crossfit', label: 'CrossFit', total: 89 },
        { id: 'pilates', label: 'Pilates', total: 76 },
        { id: 'personal', label: 'Personal Trainer', total: 123 }
      ]
    }
    
    // PADRÃO (se não identificar nicho)
    return [
      { id: 'geral', label: 'Buscar Clientes', total: 528 }
    ]
  }
  
  const abas = getAbasPorNicho()
  const [abaAtiva, setAbaAtiva] = useState<string>('dashboard')
  const [roboAtivo, setRoboAtivo] = useState(false)
  const [consultasHoje, setConsultasHoje] = useState(0)
  const [leadsEncontrados, setLeadsEncontrados] = useState(0)
  const [nichoSelecionado, setNichoSelecionado] = useState<string | null>(null)
  const [produtoSelecionado, setProdutoSelecionado] = useState<string | null>(null)

  // Produtos por nicho (mesmo de Campanhas)
  const PRODUTOS_POR_NICHO = {
    correspondente_bancario: [
      { id: 'inss', nome: 'INSS', total: 127 },
      { id: 'fgts', nome: 'Saque FGTS', total: 89 },
      { id: 'clt', nome: 'Crédito CLT', total: 156 },
      { id: 'siape', nome: 'Siape', total: 78 },
      { id: 'exercito', nome: 'Exército', total: 34 },
      { id: 'prefeituras', nome: 'Prefeituras', total: 45 }
    ],
    odontologia: [
      { id: 'implantes', nome: 'Implantes', total: 87 },
      { id: 'ortodontia', nome: 'Ortodontia', total: 134 },
      { id: 'clareamento', nome: 'Clareamento', total: 92 },
      { id: 'limpeza', nome: 'Limpeza', total: 156 },
      { id: 'canal', nome: 'Canal', total: 78 },
      { id: 'protese', nome: 'Prótese', total: 65 }
    ],
    clinica_medica: [
      { id: 'consulta_geral', nome: 'Consulta Geral', total: 312 },
      { id: 'cardiologia', nome: 'Cardiologia', total: 98 },
      { id: 'ortopedia', nome: 'Ortopedia', total: 76 },
      { id: 'dermatologia', nome: 'Dermatologia', total: 89 },
      { id: 'exames', nome: 'Exames', total: 145 },
      { id: 'checkup', nome: 'Check-up', total: 67 }
    ],
    psicologia: [
      { id: 'terapia_individual', nome: 'Terapia Individual', total: 112 },
      { id: 'terapia_casal', nome: 'Terapia de Casal', total: 43 },
      { id: 'terapia_familiar', nome: 'Terapia Familiar', total: 56 },
      { id: 'terapia_infantil', nome: 'Terapia Infantil', total: 67 },
      { id: 'avaliacao', nome: 'Avaliação', total: 34 },
      { id: 'orientacao', nome: 'Orientação', total: 45 }
    ],
    nutricao: [
      { id: 'emagrecimento', nome: 'Emagrecimento', total: 98 },
      { id: 'hipertrofia', nome: 'Hipertrofia', total: 65 },
      { id: 'reeducacao', nome: 'Reeducação', total: 87 },
      { id: 'esportiva', nome: 'Esportiva', total: 56 },
      { id: 'gestante', nome: 'Gestantes', total: 34 },
      { id: 'infantil', nome: 'Infantil', total: 43 }
    ],
    academia: [
      { id: 'musculacao', nome: 'Musculação', total: 234 },
      { id: 'crossfit', nome: 'CrossFit', total: 89 },
      { id: 'funcional', nome: 'Funcional', total: 123 },
      { id: 'spinning', nome: 'Spinning', total: 67 },
      { id: 'yoga', nome: 'Yoga', total: 45 },
      { id: 'natacao', nome: 'Natação', total: 78 }
    ]
  }

  // Simular perfil (remover quando tiver real)
  const perfilTeste = 'master'
  const nichoTeste = 'correspondente_bancario'

  // KPIs
  const kpis = {
    totalConsultas: 1247,
    consultasHoje: consultasHoje,
    leadsQuentes: leadsEncontrados,
    margemTotal: 2847500,
    taxaConversao: 34.5,
    roboAtivo: roboAtivo
  }

  const iniciarRobo = () => {
    setRoboAtivo(true)
    // Simula consultas automáticas
    const interval = setInterval(() => {
      setConsultasHoje(prev => prev + 1)
      if (Math.random() > 0.7) {
        setLeadsEncontrados(prev => prev + 1)
      }
    }, 3000)
    
    return () => clearInterval(interval)
  }

  const pararRobo = () => {
    setRoboAtivo(false)
  }

  return (
    <div className="h-full flex flex-col bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-900 dark:to-slate-800">
      {/* Header */}
      <div className="p-6 bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
        <div className="flex items-center justify-between mb-6">
          <div>
            <h1 className="text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-3">
              <div className="relative">
