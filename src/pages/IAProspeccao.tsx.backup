              >
                <Play className="w-5 h-5" />
                Iniciar Robô
              </button>
            ) : (
              <button
                onClick={pararRobo}
                className="px-6 py-3 bg-gradient-to-r from-red-500 to-red-600 text-white rounded-lg hover:from-red-600 hover:to-red-700 transition-all flex items-center gap-2 font-medium shadow-lg"
              >
                <Pause className="w-5 h-5" />
                Pausar Robô
              </button>
            )}
          </div>
        </div>

        {/* KPIs Dashboard */}
        <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
          <div className="bg-gradient-to-br from-purple-500 to-purple-600 text-white rounded-xl p-4 shadow-lg">
            <div className="flex items-center justify-between mb-2">
              <Database className="w-6 h-6 opacity-80" />
            </div>
            <div className="text-2xl font-bold">{kpis.totalConsultas.toLocaleString()}</div>
            <div className="text-xs opacity-90 mt-1">Total Consultas</div>
          </div>

          <div className="bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-xl p-4 shadow-lg">
            <div className="flex items-center justify-between mb-2">
              <Activity className={`w-6 h-6 opacity-80 ${roboAtivo ? 'animate-pulse' : ''}`} />
            </div>
            <div className="text-2xl font-bold">{kpis.consultasHoje}</div>
            <div className="text-xs opacity-90 mt-1">Consultas Hoje</div>
          </div>

          <div className="bg-gradient-to-br from-green-500 to-green-600 text-white rounded-xl p-4 shadow-lg">
            <div className="flex items-center justify-between mb-2">
              <Target className="w-6 h-6 opacity-80" />
            </div>
            <div className="text-2xl font-bold">{kpis.leadsQuentes}</div>
            <div className="text-xs opacity-90 mt-1">Leads Quentes</div>
          </div>

          <div className="bg-gradient-to-br from-emerald-500 to-emerald-600 text-white rounded-xl p-4 shadow-lg">
            <div className="flex items-center justify-between mb-2">
              <DollarSign className="w-6 h-6 opacity-80" />
            </div>
            <div className="text-2xl font-bold">R$ {(kpis.margemTotal / 1000).toFixed(0)}k</div>
            <div className="text-xs opacity-90 mt-1">Margem Total</div>
          </div>

          <div className="bg-gradient-to-br from-orange-500 to-orange-600 text-white rounded-xl p-4 shadow-lg">
            <div className="flex items-center justify-between mb-2">
              <TrendingUp className="w-6 h-6 opacity-80" />
            </div>
            <div className="text-2xl font-bold">{kpis.taxaConversao}%</div>
            <div className="text-xs opacity-90 mt-1">Taxa Conversão</div>
          </div>

          <div className={`bg-gradient-to-br ${roboAtivo ? 'from-green-500 to-green-600' : 'from-gray-500 to-gray-600'} text-white rounded-xl p-4 shadow-lg`}>
            <div className="flex items-center justify-between mb-2">
              <Shield className={`w-6 h-6 opacity-80 ${roboAtivo ? 'animate-pulse' : ''}`} />
            </div>
            <div className="text-2xl font-bold">{roboAtivo ? 'ATIVO' : 'PAUSADO'}</div>
            <div className="text-xs opacity-90 mt-1">Status do Robô</div>
          </div>
        </div>
      </div>

      {/* Abas */}
      <div className="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 overflow-x-auto">
        <div className="flex gap-1 p-2 min-w-max">
          <button
            onClick={() => setAbaAtiva('dashboard')}
            className={`px-6 py-3 rounded-lg font-medium transition-all whitespace-nowrap ${
              abaAtiva === 'dashboard'
                ? 'bg-purple-500 text-white shadow-lg'
                : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700'
            }`}
          >
            <BarChart3 className="w-4 h-4 inline mr-2" />
            Dashboard Geral
          </button>
          
          {/* Abas dinâmicas baseadas no nicho */}
          {abas.map((aba) => (
            <button
              key={aba.id}
              onClick={() => setAbaAtiva(aba.id)}
              className={`px-6 py-3 rounded-lg font-medium transition-all whitespace-nowrap ${
                abaAtiva === aba.id
                  ? 'bg-purple-500 text-white shadow-lg'
                  : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700'
              }`}
            >
              <Users className="w-4 h-4 inline mr-2" />
              {aba.label}
              <span className="ml-2 bg-green-500 text-white text-xs px-2 py-0.5 rounded-full">{aba.total}</span>
            </button>
          ))}
          
          <button
            onClick={() => setAbaAtiva('configuracoes')}
            className={`px-6 py-3 rounded-lg font-medium transition-all whitespace-nowrap ${
              abaAtiva === 'configuracoes'
                ? 'bg-purple-500 text-white shadow-lg'
                : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700'
            }`}
          >
            <Settings className="w-4 h-4 inline mr-2" />
            Configurar
          </button>
        </div>
      </div>

      {/* Conteúdo das Abas */}
      <div className="flex-1 overflow-auto p-6">
        {abaAtiva === 'dashboard' && <AbaDashboard roboAtivo={roboAtivo} />}
        {abaAtiva === 'configuracoes' && <AbaConfigurarRobo />}
        {abaAtiva !== 'dashboard' && abaAtiva !== 'configuracoes' && (
          <AbaLeadsPorNicho 
            nicho={abas.find(a => a.id === abaAtiva)?.label || ''} 
            total={abas.find(a => a.id === abaAtiva)?.total || 0} 
          />
        )}
      </div>
    </div>
  )
}

// Aba Dashboard
function AbaDashboard({ roboAtivo }: { roboAtivo: boolean }) {
  return (
    <div className="space-y-6">
      <div className="bg-white dark:bg-slate-800 rounded-xl p-6 border border-slate-200 dark:border-slate-700">
        <h2 className="text-xl font-bold text-slate-900 dark:text-white mb-4">
          Status do Robô em Tempo Real
        </h2>
        {roboAtivo ? (
          <div className="space-y-4">
            <div className="flex items-center gap-3 text-green-600">
              <div className="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
              <span className="font-medium">Robô está ATIVO e buscando leads automaticamente...</span>
            </div>
            <div className="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg p-4">
              <p className="text-sm text-green-800 dark:text-green-200">
                ✓ Consultando APIs dos bancos (INSS, Siape)<br/>
                ✓ Digitando automaticamente nos sistemas<br/>
                ✓ Identificando clientes com margem disponível<br/>
                ✓ Salvando leads no CRM automaticamente
              </p>
            </div>
          </div>
        ) : (
          <div className="text-center py-8">
            <Bot className="w-16 h-16 text-slate-300 dark:text-slate-600 mx-auto mb-4" />
            <p className="text-slate-600 dark:text-slate-400 mb-4">
              Robô está pausado. Clique em "Iniciar Robô" para começar a prospecção automática.
            </p>
          </div>
        )}
      </div>

      <div className="grid md:grid-cols-2 gap-6">
        <div className="bg-white dark:bg-slate-800 rounded-xl p-6 border border-slate-200 dark:border-slate-700">
          <h3 className="font-semibold text-slate-900 dark:text-white mb-4">Últimas Consultas</h3>
          <div className="space-y-2 text-sm text-slate-600 dark:text-slate-400">
            <p>• Consultando base INSS...</p>
            <p>• Consultando base Siape...</p>
            <p>• Consultando bancos parceiros...</p>
          </div>
        </div>

        <div className="bg-white dark:bg-slate-800 rounded-xl p-6 border border-slate-200 dark:border-slate-700">
          <h3 className="font-semibold text-slate-900 dark:text-white mb-4">Próximas Ações</h3>
          <div className="space-y-2 text-sm text-slate-600 dark:text-slate-400">
            <p>• Enviar WhatsApp para leads quentes</p>
            <p>• Gerar propostas automáticas</p>
            <p>• Criar tarefas para atendentes</p>
          </div>
        </div>
      </div>
    </div>
  )
}

