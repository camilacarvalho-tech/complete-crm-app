                    <label className="block text-sm font-medium text-slate-300 mb-2">Tags</label>
                    <input
                      type="text"
                      placeholder="Digite e pressione Enter"
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                      onKeyPress={(e) => {
                        if (e.key === 'Enter' && e.currentTarget.value.trim()) {
                          setNovoContato({
                            ...novoContato,
                            tags: [...novoContato.tags, e.currentTarget.value.trim()]
                          })
                          e.currentTarget.value = ''
                        }
                      }}
                    />
                    <div className="flex flex-wrap gap-2 mt-2">
                      {novoContato.tags.map((tag, idx) => (
                        <span key={idx} className="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs bg-green-500/10 text-green-400">
                          {tag}
                          <button
                            onClick={() => setNovoContato({
                              ...novoContato,
                              tags: novoContato.tags.filter((_, i) => i !== idx)
                            })}
                            className="hover:text-green-300"
                          >
                            <X className="w-3 h-3" />
                          </button>
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
