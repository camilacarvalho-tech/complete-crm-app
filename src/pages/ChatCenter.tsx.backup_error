// Tipos e Interfaces
type StatusAtendimento = 'Todos' | 'Não lidos' | 'Atendimento' | 'Em negociação' | 'Documentação' | 'Aguardando Cliente' | 'Finalizados' | 'Perdidos' | 'Favoritos'
type CanalComunicacao = 'WhatsApp' | 'SMS' | 'Instagram' | 'Facebook' | 'E-mail'
type TipoMensagem = 'texto' | 'imagem' | 'video' | 'audio' | 'documento' | 'localizacao'

interface Contato {
  id: string
  foto: string
  nome: string
  cpf: string
  empresa: string
  canal: CanalComunicacao
  ultimaMensagem: string
  dataHora: string
  status: StatusAtendimento
  responsavel: string
  etiquetas: string[]
  naoLidas: number
  telefone: string
  online: boolean
}

interface Mensagem {
  id: string
  texto: string
  tipo: TipoMensagem
  dataHora: string
  enviada: boolean
  lida: boolean
  anexo?: string
  respondendo?: string
  editada?: boolean
  favorita?: boolean
  fixada?: boolean
  reacoes?: { emoji: string; usuarios: string[] }[]
  agendada?: boolean
  dataAgendamento?: string
}

interface DadosCliente {
  // Dados Pessoais
  nome: string
  cpf: string
  rg: string
  cnh: string
  nascimento: string
  sexo: string
  estadoCivil: string
  nacionalidade: string
  nomeMae: string
  nomePai: string
  telefone: string
  whatsapp: string
  email: string
  // Endereço
  endereco: string
  numero: string
  complemento: string
  cidade: string
  estado: string
  cep: string
  // Profissional
  empresaTrabalha: string
  cargo: string
  salario: string
  renda: string
  score: string
  bancoPrincipal: string
  pix: string
  observacoes: string
  origemLead: string
  campanha: string
  dataCadastro: string
  responsavelAtendimento: string
  tags: string[]
  // Financeiro
  contratosAtivos: number
  valorTotal: string
  parcelas: number
  margemDisponivel: string
  // Status
  leadScore: number
  valorPotencial: string
  probabilidadeFechamento: number
  ultimoContato: string
  proximaTarefa: string
}

