                      type="text"
                      value={clienteEditando.salario}
                      onChange={(e) => setClienteEditando({...clienteEditando, salario: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                      placeholder="R$ 5.000,00"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Renda Total</label>
                    <input
                      type="text"
                      value={clienteEditando.renda}
                      onChange={(e) => setClienteEditando({...clienteEditando, renda: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                      placeholder="R$ 5.000,00"
                    />
                  </div>
                </div>
              </div>

              {/* SEÇÃO: Dados Financeiros */}
              <div>
                <h3 className="text-lg font-bold text-white mb-4 flex items-center gap-2">
                  <DollarSign className="w-5 h-5 text-green-400" />
                  Dados Financeiros
                </h3>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Score</label>
                    <input
                      type="text"
                      value={clienteEditando.score}
                      onChange={(e) => setClienteEditando({...clienteEditando, score: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                      placeholder="750"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Banco Principal</label>
                    <input
                      type="text"
                      value={clienteEditando.bancoPrincipal}
                      onChange={(e) => setClienteEditando({...clienteEditando, bancoPrincipal: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                      placeholder="Banco do Brasil"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Chave PIX</label>
                    <input
                      type="text"
                      value={clienteEditando.pix}
                      onChange={(e) => setClienteEditando({...clienteEditando, pix: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                      placeholder="CPF, E-mail ou Celular"
                    />
                  </div>
                </div>
              </div>

              {/* SEÇÃO: Upload de Documentos */}
              <div>
                <h3 className="text-lg font-bold text-white mb-4 flex items-center gap-2">
                  <Upload className="w-5 h-5 text-green-400" />
                  Documentos
                </h3>
                <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                  <button className="flex flex-col items-center justify-center gap-2 bg-slate-900 hover:bg-slate-700 border-2 border-dashed border-slate-600 hover:border-green-500 rounded-lg p-4 transition-all group">
                    <Upload className="w-8 h-8 text-slate-400 group-hover:text-green-400" />
                    <span className="text-sm text-slate-400 group-hover:text-white">RG</span>
                  </button>
                  <button className="flex flex-col items-center justify-center gap-2 bg-slate-900 hover:bg-slate-700 border-2 border-dashed border-slate-600 hover:border-green-500 rounded-lg p-4 transition-all group">
                    <Upload className="w-8 h-8 text-slate-400 group-hover:text-green-400" />
                    <span className="text-sm text-slate-400 group-hover:text-white">CPF</span>
                  </button>
                  <button className="flex flex-col items-center justify-center gap-2 bg-slate-900 hover:bg-slate-700 border-2 border-dashed border-slate-600 hover:border-green-500 rounded-lg p-4 transition-all group">
                    <Upload className="w-8 h-8 text-slate-400 group-hover:text-green-400" />
                    <span className="text-sm text-slate-400 group-hover:text-white">CNH</span>
                  </button>
                  <button className="flex flex-col items-center justify-center gap-2 bg-slate-900 hover:bg-slate-700 border-2 border-dashed border-slate-600 hover:border-green-500 rounded-lg p-4 transition-all group">
                    <Upload className="w-8 h-8 text-slate-400 group-hover:text-green-400" />
                    <span className="text-sm text-slate-400 group-hover:text-white">Comprovante</span>
                  </button>
                </div>
              </div>

              {/* SEÇÃO: Observações */}
              <div>
                <h3 className="text-lg font-bold text-white mb-4 flex items-center gap-2">
                  <FileText className="w-5 h-5 text-green-400" />
                  Observações
                </h3>
                <textarea
                  value={clienteEditando.observacoes}
                  onChange={(e) => setClienteEditando({...clienteEditando, observacoes: e.target.value})}
                  rows={4}
                  className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500 resize-none"
                  placeholder="Anotações importantes sobre o cliente..."
                />
              </div>
            </div>

            {/* Footer do Modal */}
            <div className="p-6 border-t border-slate-700 sticky bottom-0 bg-slate-800 flex gap-3">
              <button
                onClick={() => {
                  setMostrarFormularioCliente(false)
                  setClienteEditando(null)
                }}
                className="flex-1 bg-slate-700 hover:bg-slate-600 text-white px-6 py-3 rounded-lg font-medium transition-colors"
              >
                Cancelar
              </button>
              <button
                onClick={salvarDadosCliente}
                className="flex-1 bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-medium transition-colors flex items-center justify-center gap-2"
              >
                <CheckCheck className="w-5 h-5" />
                Salvar Alterações
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  )
}
