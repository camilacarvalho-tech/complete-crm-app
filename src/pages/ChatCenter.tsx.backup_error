  // Emojis comuns
  const emojisComuns = ['👍', '❤️', '😊', '🎉', '✅', '👏', '🙏', '💼', '📄', '📞']

  // Filtros de Status
  const filtros: StatusAtendimento[] = [
    'Todos',
    'Não lidos',
    'Atendimento',
    'Em negociação',
    'Documentação',
    'Aguardando Cliente',
    'Finalizados',
    'Perdidos',
    'Favoritos'
  ]

  // Filtrar contatos
  const contatosFiltrados = contatos.filter(contato => {
    const matchFiltro = filtroAtivo === 'Todos' || contato.status === filtroAtivo
    const matchBusca = 
      contato.nome.toLowerCase().includes(buscaContato.toLowerCase()) ||
      contato.cpf.includes(buscaContato) ||
      contato.telefone.includes(buscaContato) ||
      contato.empresa.toLowerCase().includes(buscaContato.toLowerCase())
    return matchFiltro && matchBusca
  })

  // Função para enviar mensagem
  const enviarMensagem = () => {
    if (novaMensagem.trim() && contatoSelecionado) {
      const agora = new Date()
      const dataHora = agora.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })
      
      const novaMensagemObj: Mensagem = {
        id: `msg-${Date.now()}`,
        texto: novaMensagem,
        tipo: 'texto',
        dataHora: dataHora,
        enviada: true,
        lida: false
      }

      // Atualizar mensagens do contato
      const mensagensAtuais = mensagensState[contatoSelecionado.id] || mensagens
      setMensagensState({
        ...mensagensState,
        [contatoSelecionado.id]: [...mensagensAtuais, novaMensagemObj]
      })
      
      setNovaMensagem('')
      
      // Scroll automático
      setTimeout(() => {
        const chatContainer = document.getElementById('chat-messages-container')
        if (chatContainer) {
          chatContainer.scrollTop = chatContainer.scrollHeight
        }
      }, 100)
    }
  }

  // Função para selecionar contato
  const selecionarContato = (contato: Contato) => {
    setContatoSelecionado(contato)
    // Marcar como lidas
    if (contato.naoLidas > 0) {
      contato.naoLidas = 0
    }
    // Abrir formulário do cliente com dados
    setMostrarFormularioCliente(true)
    setClienteEditando({
      nome: contato.nome,
      cpf: contato.cpf,
      rg: '',
      cnh: '',
      nascimento: '',
      sexo: '',
      estadoCivil: '',
      nacionalidade: 'Brasileira',
      nomeMae: '',
      nomePai: '',
