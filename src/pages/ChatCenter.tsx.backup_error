  // Funções de IA
  const processarIA = async (acao: string, contexto?: string) => {
    setProcessandoIA(true)
    // Simulação de processamento IA
    setTimeout(() => {
      let resultado = ''
      
      switch(acao) {
        case 'melhorar':
          resultado = `Olá! Fico feliz em ajudá-lo com informações sobre nossos produtos de financiamento. Poderia me informar qual o valor que você necessita?`
          break
        case 'corrigir':
          resultado = textoIA.replace(/erros/g, 'correções').trim()
