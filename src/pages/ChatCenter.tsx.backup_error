        case 'profissional':
          resultado = `Prezado(a) cliente, cordialmente informamos que estamos à disposição para esclarecimentos adicionais sobre nossos serviços financeiros.`
          break
        case 'diminuir':
          resultado = `Olá! Como posso ajudar com financiamento?`
          break
        case 'aumentar':
          resultado = `Olá! Muito obrigado por entrar em contato conosco. Ficamos muito felizes em poder ajudá-lo com informações detalhadas sobre nossas diversas opções de financiamento disponíveis. Por gentileza, poderia nos informar qual seria o valor aproximado que você está necessitando para que possamos preparar a melhor proposta possível para o seu caso específico?`
          break
        case 'cobranca':
          resultado = `Olá [Nome]! Identificamos que sua fatura no valor de R$ [Valor] com vencimento em [Data] está pendente. Para evitar juros e garantir a continuidade dos serviços, pedimos que regularize o pagamento. Estamos à disposição para negociar! PIX: [Chave] | Boleto: [Link]`
          break
        case 'venda':
          resultado = `Olá [Nome]! 🎉 Temos uma oportunidade incrível para você! Nosso produto [Nome Produto] está com condições especiais: ✨ Desconto de [X]% ✨ Parcelas facilitadas ✨ Aprovação rápida. Não perca essa chance! Quer saber mais?`
          break
        case 'pos-venda':
          resultado = `Olá [Nome]! Esperamos que esteja satisfeito(a) com sua aquisição. Gostaríamos de saber como foi sua experiência. Sua opinião é muito importante para nós! 📋 Pesquisa: [Link] 🎁 E mais: Indique um amigo e ganhe [Benefício]!`
          break
        case 'fgts':
          resultado = `Olá [Nome]! 🏦 Seu FGTS está disponível para saque-aniversário! Valores: 💰 Disponível: R$ [Valor] 📅 Liberação: Imediata 💳 Crédito em conta: 24h Documentos necessários: CPF, RG e comprovante de residência. Deseja simular?`
          break
        case 'inss':
          resultado = `Olá [Nome]! Boas notícias sobre seu crédito consignado INSS! 📊 Margem disponível: R$ [Valor] 💵 Taxa: [X]% ao mês 📆 Parcelas: até 84x ✅ Desconto direto no benefício Quer receber uma proposta personalizada?`
          break
        case 'refinanciamento':
          resultado = `Olá [Nome]! Que tal reduzir suas parcelas? 💡 Refinanciamento Inteligente: 📉 Reduza até [X]% das parcelas 💰 Libere mais dinheiro 📅 Prazos estendidos ✅ Aprovação rápida Vamos fazer uma simulação?`
          break
        case 'personalizada':
          resultado = `Mensagem personalizada gerada com base no contexto fornecido...`
          break
        case 'traduzir':
          resultado = `[EN] Hello! I would like information about financing. [ES] ¡Hola! Me gustaría información sobre financiación.`
          break
        case 'analisar':
          resultado = `📊 Análise de Sentimento:\n\n✅ Tom: Positivo/Neutro\n😊 Emoção: Interessado\n🎯 Intenção: Busca informações\n⚡ Urgência: Média\n💡 Sugestão: Cliente demonstra interesse genuíno. Responda com proposta clara e objetiva.`
          break
        case 'sugerir':
          resultado = `Olá! Claro, ficarei feliz em ajudar com informações sobre financiamento. Para preparar a melhor proposta, preciso saber: qual o valor aproximado que você necessita e qual seria a finalidade do crédito?`
          break
        default:
          resultado = textoIA
      }
      
      setResultadoIA(resultado)
      setProcessandoIA(false)
    }, 1500)
  }

  const usarTextoIA = () => {
    setNovaMensagem(resultadoIA)
    setMostrarModalIA(false)
    setTextoIA('')
    setResultadoIA('')
  }

  // Get Canal Cor
  const getCanalCor = (canal: CanalComunicacao) => {
    switch (canal) {
      case 'WhatsApp': return 'bg-green-500'
      case 'Instagram': return 'bg-purple-500'
      case 'Facebook': return 'bg-blue-600'
      case 'SMS': return 'bg-yellow-500'
      case 'E-mail': return 'bg-red-500'
    }
  }

  return (
    <div className="flex h-screen bg-slate-900">
      {/* COLUNA 1 - LISTA DE CONVERSAS */}
      <div className="w-96 border-r border-slate-700 flex flex-col bg-slate-800">
        {/* Header */}
        <div className="p-4 border-b border-slate-700">
          <div className="flex items-center justify-between mb-4">
            <h2 className="text-xl font-bold text-white flex items-center gap-2">
              <MessageSquare className="w-6 h-6 text-green-400" />
              Chat Center
            </h2>
            <button className="bg-green-600 hover:bg-green-700 text-white p-2 rounded-lg transition-colors" onClick={() => setMostrarModalNovoContato(true)}>
              <Plus className="w-5 h-5" />
            </button>
          </div>

          {/* Busca */}
          <div className="relative mb-3">
            <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400 w-4 h-4" />
            <input
              type="text"
              placeholder="Buscar por nome, CPF, telefone, empresa..."
              value={buscaContato}
              onChange={(e) => setBuscaContato(e.target.value)}
              className="w-full bg-slate-900 border border-slate-700 rounded-lg pl-10 pr-3 py-2 text-sm text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
            />
          </div>

          {/* Filtros */}
          <div className="flex gap-2 overflow-x-auto pb-2 scrollbar-thin scrollbar-thumb-slate-700">
            {filtros.map(filtro => (
              <button
                key={filtro}
                onClick={() => setFiltroAtivo(filtro)}
                className={`px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition-colors ${
                  filtroAtivo === filtro
                    ? 'bg-green-600 text-white'
                    : 'bg-slate-700 text-slate-300 hover:bg-slate-600'
                }`}
              >
                {filtro}
              </button>
            ))}
          </div>
        </div>
        {/* Lista de Contatos */}
        <div className="flex-1 overflow-y-auto">
          {contatosFiltrados.map(contato => (
            <button
              key={contato.id}
              onClick={() => selecionarContato(contato)}
              className={`w-full p-4 flex gap-3 hover:bg-slate-700 transition-colors border-b border-slate-700/50 ${
                contatoSelecionado?.id === contato.id ? 'bg-slate-700' : ''
              }`}
            >
              {/* Avatar */}
              <div className="relative flex-shrink-0">
                <div className="w-12 h-12 bg-gradient-to-br from-green-500 to-blue-500 rounded-full flex items-center justify-center text-white font-bold">
                  {contato.nome.split(' ').map(n => n[0]).join('').slice(0, 2)}
                </div>
                {contato.online && (
                  <div className="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-slate-800" />
                )}
                {/* Badge Canal */}
                <div className={`absolute -top-1 -right-1 ${getCanalCor(contato.canal)} w-5 h-5 rounded-full flex items-center justify-center`}>
                  {contato.canal === 'WhatsApp' && <MessageSquare className="w-3 h-3 text-white" />}
                  {contato.canal === 'Instagram' && <ImageIcon className="w-3 h-3 text-white" />}
                  {contato.canal === 'E-mail' && <FileText className="w-3 h-3 text-white" />}
                </div>
              </div>

              {/* Informações */}
              <div className="flex-1 min-w-0 text-left">
                <div className="flex items-center justify-between mb-1">
                  <h3 className="text-white font-semibold text-sm truncate">{contato.nome}</h3>
                  <span className="text-xs text-slate-400 ml-2">{contato.dataHora}</span>
                </div>
                <div className="flex items-center gap-2 mb-1">
                  <span className="text-xs text-slate-400">{contato.cpf}</span>
                  <span className="text-xs text-slate-500">•</span>
                  <span className="text-xs text-slate-400 truncate">{contato.empresa}</span>
                </div>

                <p className="text-sm text-slate-300 truncate mb-2">{contato.ultimaMensagem}</p>

                {/* Etiquetas */}
                <div className="flex flex-wrap gap-1">
                  {contato.etiquetas.slice(0, 2).map((etiqueta, idx) => (
                    <span key={idx} className="text-xs bg-green-500/10 text-green-400 px-2 py-0.5 rounded">
                      {etiqueta}
                    </span>
                  ))}
                  {contato.etiquetas.length > 2 && (
                    <span className="text-xs text-slate-400">+{contato.etiquetas.length - 2}</span>
                  )}
                </div>

                <div className="flex items-center justify-between mt-2">
                  <span className="text-xs text-slate-500">
                    <User className="w-3 h-3 inline mr-1" />
                    {contato.responsavel}
                  </span>
                  {contato.naoLidas > 0 && (
                    <div className="bg-green-500 text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center">
                      {contato.naoLidas}
                    </div>
                  )}
                </div>
              </div>
            </button>
          ))}
        </div>
      </div>

      {/* COLUNA 2 - ÁREA DE CHAT */}
      <div className="flex-1 flex flex-col bg-slate-900">
        {contatoSelecionado ? (
          <>
            {/* Header do Chat */}
            <div className="p-4 border-b border-slate-700 flex items-center justify-between bg-slate-800">
              <div className="flex items-center gap-3">
                <div className="relative">
                  <div className="w-10 h-10 bg-gradient-to-br from-green-500 to-blue-500 rounded-full flex items-center justify-center text-white font-bold">
                    {contatoSelecionado.nome.split(' ').map(n => n[0]).join('').slice(0, 2)}
                  </div>
                  {contatoSelecionado.online && (
                    <div className="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-slate-800" />
                  )}
                </div>
                <div>
                  <h3 className="text-white font-semibold">{contatoSelecionado.nome}</h3>
                  <p className="text-xs text-slate-400">
                    {contatoSelecionado.online ? 'Online' : `Visto por último ${contatoSelecionado.dataHora}`}
                  </p>
                </div>
              </div>

              <div className="flex items-center gap-2">
                <button className="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-700 transition-colors">
                  <Search className="w-5 h-5" />
                </button>
                <button className="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-700 transition-colors">
                  <Phone className="w-5 h-5" />
                </button>
                <button className="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-700 transition-colors">
                  <Video className="w-5 h-5" />
                </button>
                <button 
                  onClick={() => setMostrarPainelCliente(!mostrarPainelCliente)}
                  className="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-700 transition-colors"
                >
                  <User className="w-5 h-5" />
                </button>
                <button className="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-700 transition-colors">
                  <MoreVertical className="w-5 h-5" />
                </button>
              </div>
            </div>
            {/* Área de Mensagens */}
            <div id="chat-messages-container" className="flex-1 overflow-y-auto p-4 space-y-3 bg-slate-900/50">
              {/* Mensagem respondendo */}
              {mensagemRespondendo && (
                <div className="bg-slate-800 border-l-4 border-green-500 rounded p-3 mb-3">
                  <div className="flex items-center justify-between mb-1">
                    <span className="text-xs text-green-400 font-medium">Respondendo</span>
                    <button onClick={() => setMensagemRespondendo(null)} className="text-slate-400 hover:text-white">
                      <X className="w-4 h-4" />
                    </button>
                  </div>
                  <p className="text-sm text-slate-300 truncate">{mensagemRespondendo.texto}</p>
                </div>
              )}

              {obterMensagensContato().map(mensagem => (
                <div
                  key={mensagem.id}
                  className={`flex ${mensagem.enviada ? 'justify-end' : 'justify-start'} group`}
                  onMouseEnter={() => setMensagemSelecionada(mensagem.id)}
                  onMouseLeave={() => setMensagemSelecionada(null)}
                >
                  <div className="relative max-w-md">
                    {/* Menu de ações (aparece no hover) */}
                    {mensagemSelecionada === mensagem.id && (
                      <div className={`absolute -top-8 ${mensagem.enviada ? 'right-0' : 'left-0'} flex gap-1 bg-slate-800 border border-slate-700 rounded-lg p-1 shadow-lg`}>
                        <button
                          onClick={() => reagirMensagem(mensagem.id, '👍')}
                          className="text-slate-400 hover:text-white p-1 hover:bg-slate-700 rounded transition-colors"
                          title="Reagir"
                        >
                          <Smile className="w-4 h-4" />
                        </button>
                        <button
                          onClick={() => responderMensagem(mensagem)}
                          className="text-slate-400 hover:text-white p-1 hover:bg-slate-700 rounded transition-colors"
                          title="Responder"
                        >
                          <Reply className="w-4 h-4" />
                        </button>
                        <button
                          onClick={() => encaminharMensagem(mensagem.id)}
                          className="text-slate-400 hover:text-white p-1 hover:bg-slate-700 rounded transition-colors"
                          title="Encaminhar"
                        >
                          <Forward className="w-4 h-4" />
                        </button>
                        {mensagem.enviada && (
                          <button
                            onClick={() => editarMensagem(mensagem.id)}
                            className="text-slate-400 hover:text-white p-1 hover:bg-slate-700 rounded transition-colors"
                            title="Editar"
                          >
                            <Edit className="w-4 h-4" />
                          </button>
                        )}
                        <button
                          onClick={() => favoritarMensagem(mensagem.id)}
                          className="text-slate-400 hover:text-white p-1 hover:bg-slate-700 rounded transition-colors"
                          title="Favoritar"
                        >
                          <Star className={`w-4 h-4 ${mensagem.favorita ? 'fill-yellow-400 text-yellow-400' : ''}`} />
                        </button>
                        <button
                          onClick={() => setMostrarMenuMensagem(mensagem.id)}
                          className="text-slate-400 hover:text-white p-1 hover:bg-slate-700 rounded transition-colors"
                          title="Mais opções"
                        >
                          <MoreVertical className="w-4 h-4" />
                        </button>
                      </div>
                    )}

                    {/* Menu expandido */}
                    {mostrarMenuMensagem === mensagem.id && (
                      <div className={`absolute top-8 ${mensagem.enviada ? 'right-0' : 'left-0'} bg-slate-800 border border-slate-700 rounded-lg shadow-lg py-1 w-48 z-10`}>
                        <button
                          onClick={() => fixarMensagem(mensagem.id)}
                          className="w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 flex items-center gap-2"
                        >
                          <Bell className="w-4 h-4" />
                          Fixar mensagem
                        </button>
                        <button
                          onClick={() => console.log('Criar lembrete')}
                          className="w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 flex items-center gap-2"
                        >
                          <Clock className="w-4 h-4" />
                          Criar lembrete
                        </button>
                        <button
                          onClick={() => console.log('Criar tarefa')}
                          className="w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 flex items-center gap-2"
                        >
                          <CheckCheck className="w-4 h-4" />
                          Criar tarefa
                        </button>
                        <button
                          onClick={() => excluirMensagem(mensagem.id)}
                          className="w-full text-left px-4 py-2 text-sm text-red-400 hover:bg-slate-700 flex items-center gap-2"
                        >
                          <Trash2 className="w-4 h-4" />
                          Excluir
                        </button>
                      </div>
                    )}

                    <div className={`px-4 py-2.5 rounded-2xl ${
                      mensagem.enviada
                        ? 'bg-green-600 text-white rounded-br-sm'
                        : 'bg-slate-800 text-white rounded-bl-sm'
                    }`}>
                      {mensagem.fixada && (
                        <div className="flex items-center gap-1 text-xs opacity-70 mb-1">
                          <Bell className="w-3 h-3" />
                          Fixada
                        </div>
                      )}
                      <p className="text-sm whitespace-pre-wrap break-words">{mensagem.texto}</p>
                      {mensagem.editada && (
                        <span className="text-xs opacity-70 ml-2">(editada)</span>
                      )}
                      <div className="flex items-center justify-end gap-1 mt-1">
                        <span className={`text-xs ${mensagem.enviada ? 'text-green-100' : 'text-slate-400'}`}>
                          {mensagem.dataHora}
                        </span>
                        {mensagem.enviada && (
                          <CheckCheck className={`w-4 h-4 ${mensagem.lida ? 'text-blue-300' : 'text-green-100'}`} />
                        )}
                      </div>
                    </div>

                    {/* Reações */}
                    {mensagem.reacoes && mensagem.reacoes.length > 0 && (
                      <div className="flex gap-1 mt-1">
                        {mensagem.reacoes.map((reacao, idx) => (
                          <div key={idx} className="bg-slate-800 rounded-full px-2 py-0.5 text-xs flex items-center gap-1">
                            <span>{reacao.emoji}</span>
                            <span className="text-slate-400">{reacao.usuarios.length}</span>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>

            {/* Input de Mensagem */}
            <div className="p-4 border-t border-slate-700 bg-slate-800">
              {/* Respostas Rápidas */}
              {mostrarRespostasRapidas && (
                <div className="mb-3 bg-slate-900 border border-slate-700 rounded-lg p-3">
                  <div className="flex items-center justify-between mb-2">
                    <h4 className="text-sm font-medium text-white">Respostas Rápidas</h4>
                    <button onClick={() => setMostrarRespostasRapidas(false)} className="text-slate-400 hover:text-white">
                      <X className="w-4 h-4" />
                    </button>
                  </div>
                  <div className="grid grid-cols-2 gap-2">
                    {respostasRapidas.map((resposta, idx) => (
                      <button
                        key={idx}
                        onClick={() => {
                          setNovaMensagem(resposta)
                          setMostrarRespostasRapidas(false)
                        }}
                        className="text-left px-3 py-2 text-sm bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700 transition-colors"
                      >
                        {resposta}
                      </button>
                    ))}
                  </div>
                </div>
              )}

              {/* Agendamento */}
              {mostrarAgendamento && (
                <div className="mb-3 bg-slate-900 border border-slate-700 rounded-lg p-4">
                  <div className="flex items-center justify-between mb-3">
                    <h4 className="text-sm font-medium text-white flex items-center gap-2">
                      <Calendar className="w-4 h-4 text-green-400" />
                      Agendar Envio
                    </h4>
                    <button onClick={() => setMostrarAgendamento(false)} className="text-slate-400 hover:text-white">
                      <X className="w-4 h-4" />
                    </button>
                  </div>
                  <div className="grid grid-cols-2 gap-3 mb-3">
                    <div>
                      <label className="block text-xs text-slate-400 mb-1">Data</label>
                      <input
                        type="date"
                        value={dataAgendamento}
                        onChange={(e) => setDataAgendamento(e.target.value)}
                        className="w-full bg-slate-800 border border-slate-700 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-green-500"
                      />
                    </div>
                    <div>
                      <label className="block text-xs text-slate-400 mb-1">Hora</label>
                      <input
                        type="time"
                        value={horaAgendamento}
                        onChange={(e) => setHoraAgendamento(e.target.value)}
                        className="w-full bg-slate-800 border border-slate-700 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-green-500"
                      />
                    </div>
                  </div>
                  <button
                    onClick={agendarMensagem}
                    className="w-full bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded text-sm font-medium transition-colors"
                  >
                    Confirmar Agendamento
                  </button>
                </div>
              )}

              {/* Picker de Emojis */}
              {mostrarEmojis && (
                <div className="mb-3 bg-slate-900 border border-slate-700 rounded-lg p-3">
                  <div className="flex items-center justify-between mb-2">
                    <h4 className="text-sm font-medium text-white">Emojis</h4>
                    <button onClick={() => setMostrarEmojis(false)} className="text-slate-400 hover:text-white">
                      <X className="w-4 h-4" />
                    </button>
                  </div>
                  <div className="flex flex-wrap gap-2">
                    {emojisComuns.map((emoji, idx) => (
                      <button
                        key={idx}
                        onClick={() => {
                          setNovaMensagem(novaMensagem + emoji)
                          setMostrarEmojis(false)
                        }}
                        className="text-2xl hover:bg-slate-800 p-2 rounded transition-colors"
                      >
                        {emoji}
                      </button>
                    ))}
                  </div>
                </div>
              )}

              <div className="flex items-end gap-3">
                <div className="relative">
                  <button
                    onClick={() => setMostrarRespostasRapidas(!mostrarRespostasRapidas)}
                    className="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-700 transition-colors"
                    title="Respostas Rápidas"
                  >
                    <MessageCircle className="w-5 h-5" />
                  </button>
                </div>

                <div className="relative">
                  <button
                    onClick={() => {
                      setTextoIA(novaMensagem)
                      setMostrarModalIA(true)
                    }}
                    className="text-purple-400 hover:text-purple-300 p-2 rounded-lg hover:bg-slate-700 transition-colors relative"
                    title="Assistente IA"
                  >
                    <Bot className="w-5 h-5" />
                    <span className="absolute -top-1 -right-1 bg-purple-500 text-white text-[10px] font-bold rounded-full w-4 h-4 flex items-center justify-center">
                      IA
                    </span>
                  </button>
                </div>
                
                <div className="flex-1 relative">
                  <textarea
                    value={novaMensagem}
                    onChange={(e) => setNovaMensagem(e.target.value)}
                    onKeyPress={(e) => {
                      if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault()
                        enviarMensagem()
                      }
                    }}
                    placeholder="Digite sua mensagem..."
                    rows={1}
                    className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2.5 text-white placeholder-slate-400 focus:outline-none focus:border-green-500 resize-none"
                  />
                </div>

                <button
                  onClick={() => setMostrarAgendamento(!mostrarAgendamento)}
                  className="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-700 transition-colors"
                  title="Agendar Envio"
                >
                  <Calendar className="w-5 h-5" />
                </button>
                <button className="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-700 transition-colors" title="Anexar Arquivo">
                  <Paperclip className="w-5 h-5" />
                </button>
                <button
                  onClick={() => setMostrarEmojis(!mostrarEmojis)}
                  className="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-700 transition-colors"
                  title="Emojis"
                >
                  <Smile className="w-5 h-5" />
                </button>
                <button className="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-700 transition-colors" title="Gravar Áudio">
                  <Mic className="w-5 h-5" />
                </button>
                
                <button
                  onClick={enviarMensagem}
                  disabled={!novaMensagem.trim()}
                  className="bg-green-600 hover:bg-green-700 disabled:bg-slate-700 disabled:cursor-not-allowed text-white p-3 rounded-lg transition-colors"
                >
                  <Send className="w-5 h-5" />
                </button>
              </div>
              <p className="text-xs text-slate-500 mt-2 ml-12">
                Enter para enviar • Shift + Enter para nova linha
              </p>
            </div>
          </>
        ) : (
          <div className="flex-1 flex items-center justify-center">
            <div className="text-center">
              <MessageSquare className="w-20 h-20 text-slate-600 mx-auto mb-4" />
              <h3 className="text-xl font-bold text-slate-400 mb-2">Selecione uma conversa</h3>
              <p className="text-slate-500">Escolha um contato para começar o atendimento</p>
            </div>
          </div>
        )}
      </div>

      {/* COLUNA 3 - FORMULÁRIO DO CLIENTE */}
      {mostrarFormularioCliente && clienteEditando && (
        <div className="w-96 border-l border-slate-700 bg-slate-800 overflow-y-auto">
          <div className="p-4">
            {/* Header */}
            <div className="flex items-center justify-between mb-6">
              <h2 className="text-lg font-bold text-white">Dados do Cliente</h2>
              <button
                onClick={() => setMostrarFormularioCliente(false)}
                className="p-2 text-slate-400 hover:bg-slate-700 rounded-lg transition-colors"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            {/* Formulário Completo */}
            <div className="space-y-4">
              {/* Nome */}
              <div>
                <label className="text-xs text-slate-400 block mb-1">Nome Completo</label>
                <input
                  type="text"
                  value={clienteEditando.nome}
                  onChange={(e) => setClienteEditando({...clienteEditando, nome: e.target.value})}
                  className="w-full bg-slate-700 text-white px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
                />
              </div>

              {/* CPF com máscara */}
              <div>
                <label className="text-xs text-slate-400 block mb-1">CPF</label>
                <input
                  type="text"
                  value={clienteEditando.cpf}
                  onChange={(e) => {
                    const valor = e.target.value
                      .replace(/\D/g, '')
                      .replace(/(\d{3})(\d)/, '$1.$2')
                      .replace(/(\d{3})(\d)/, '$1.$2')
                      .replace(/(\d{3})(\d{1,2})/, '$1-$2')
                      .replace(/(-\d{2})\d+?$/, '$1')
                    setClienteEditando({...clienteEditando, cpf: valor})
                  }}
                  placeholder="000.000.000-00"
                  maxLength={14}
                  className="w-full bg-slate-700 text-white px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
                />
              </div>

              {/* Data de Nascimento com máscara */}
              <div>
                <label className="text-xs text-slate-400 block mb-1">Data de Nascimento</label>
                <input
                  type="text"
                  value={clienteEditando.nascimento}
                  onChange={(e) => {
                    const valor = e.target.value
                      .replace(/\D/g, '')
                      .replace(/(\d{2})(\d)/, '$1/$2')
                      .replace(/(\d{2})(\d)/, '$1/$2')
                      .replace(/(\/\d{4})\d+?$/, '$1')
                    setClienteEditando({...clienteEditando, nascimento: valor})
                  }}
                  placeholder="DD/MM/AAAA"
                  maxLength={10}
                  className="w-full bg-slate-700 text-white px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
                />
              </div>

              {/* Telefone com máscara */}
              <div>
                <label className="text-xs text-slate-400 block mb-1">Telefone</label>
                <input
                  type="text"
                  value={clienteEditando.telefone}
                  onChange={(e) => {
                    const valor = e.target.value
                      .replace(/\D/g, '')
                      .replace(/(\d{2})(\d)/, '($1) $2')
                      .replace(/(\d{5})(\d)/, '$1-$2')
                      .replace(/(-\d{4})\d+?$/, '$1')
                    setClienteEditando({...clienteEditando, telefone: valor})
                  }}
                  placeholder="(00) 00000-0000"
                  maxLength={15}
                  className="w-full bg-slate-700 text-white px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
                />
              </div>

              {/* Email */}
              <div>
                <label className="text-xs text-slate-400 block mb-1">Email</label>
                <input
                  type="email"
                  value={clienteEditando.email}
                  onChange={(e) => setClienteEditando({...clienteEditando, email: e.target.value})}
                  className="w-full bg-slate-700 text-white px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
                />
              </div>

              {/* Empresa */}
              <div>
                <label className="text-xs text-slate-400 block mb-1">Empresa</label>
                <input
                  type="text"
                  value={clienteEditando.empresaTrabalha}
                  onChange={(e) => setClienteEditando({...clienteEditando, empresaTrabalha: e.target.value})}
                  className="w-full bg-slate-700 text-white px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
                />
              </div>

              {/* Endereço */}
              <div>
                <label className="text-xs text-slate-400 block mb-1">Endereço</label>
                <input
                  type="text"
                  value={clienteEditando.endereco}
                  onChange={(e) => setClienteEditando({...clienteEditando, endereco: e.target.value})}
                  className="w-full bg-slate-700 text-white px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
                />
              </div>

              {/* Cidade e Estado */}
              <div className="grid grid-cols-2 gap-2">
                <div>
                  <label className="text-xs text-slate-400 block mb-1">Cidade</label>
                  <input
                    type="text"
                    value={clienteEditando.cidade}
                    onChange={(e) => setClienteEditando({...clienteEditando, cidade: e.target.value})}
                    className="w-full bg-slate-700 text-white px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
                  />
                </div>
                <div>
                  <label className="text-xs text-slate-400 block mb-1">Estado</label>
                  <input
                    type="text"
                    value={clienteEditando.estado}
                    onChange={(e) => setClienteEditando({...clienteEditando, estado: e.target.value})}
                    maxLength={2}
                    className="w-full bg-slate-700 text-white px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
                  />
                </div>
              </div>

              {/* CEP */}
              <div>
                <label className="text-xs text-slate-400 block mb-1">CEP</label>
                <input
                  type="text"
                  value={clienteEditando.cep}
                  onChange={(e) => {
                    const valor = e.target.value
                      .replace(/\D/g, '')
                      .replace(/(\d{5})(\d)/, '$1-$2')
                      .replace(/(-\d{3})\d+?$/, '$1')
                    setClienteEditando({...clienteEditando, cep: valor})
                  }}
                  placeholder="00000-000"
                  maxLength={9}
                  className="w-full bg-slate-700 text-white px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
                />
              </div>

              {/* Funil/Status */}
              <div>
                <label className="text-xs text-slate-400 block mb-1">Funil</label>
                <select
                  value={contatoSelecionado?.status || 'Atendimento'}
                  onChange={(e) => {
                    if (contatoSelecionado) {
                      contatoSelecionado.status = e.target.value as StatusAtendimento
                    }
                  }}
                  className="w-full bg-slate-700 text-white px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
                >
                  <option value="Não lidos">Não lidos</option>
                  <option value="Atendimento">Atendimento</option>
                  <option value="Em negociação">Em negociação</option>
                  <option value="Documentação">Documentação</option>
                  <option value="Aguardando Cliente">Aguardando Cliente</option>
                  <option value="Finalizados">Finalizados</option>
                  <option value="Perdidos">Perdidos</option>
                </select>
              </div>

              {/* Responsável */}
              <div>
                <label className="text-xs text-slate-400 block mb-1">Responsável</label>
                <input
                  type="text"
                  value={clienteEditando.responsavelAtendimento}
                  onChange={(e) => setClienteEditando({...clienteEditando, responsavelAtendimento: e.target.value})}
                  className="w-full bg-slate-700 text-white px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
                />
              </div>

              {/* Observações */}
              <div>
                <label className="text-xs text-slate-400 block mb-1">Observações</label>
                <textarea
                  value={clienteEditando.observacoes}
                  onChange={(e) => setClienteEditando({...clienteEditando, observacoes: e.target.value})}
                  rows={4}
                  className="w-full bg-slate-700 text-white px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500 resize-none"
                />
              </div>

              {/* BOTÃO SALVAR GRANDE */}
              <button
                onClick={salvarDadosCliente}
                className="w-full bg-gradient-to-r from-green-600 to-green-500 hover:from-green-700 hover:to-green-600 text-white py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-3 transition-all shadow-lg hover:shadow-xl mt-6"
              >
                <Upload className="w-6 h-6" />
                SALVAR ALTERAÇÕES
              </button>
            </div>
          </div>
        </div>
      )}

      {/* MODAL ASSISTENTE IA */}
      {mostrarModalIA && (
        <div className="fixed inset-0 bg-black/70 flex items-center justify-center z-50 p-4">
          <div className="bg-slate-800 border border-slate-700 rounded-lg max-w-4xl w-full max-h-[90vh] overflow-y-auto">
            <div className="p-6 border-b border-slate-700">
              <div className="flex items-center justify-between">
                <h2 className="text-2xl font-bold text-white flex items-center gap-2">
                  <Bot className="w-6 h-6 text-purple-400" />
                  Assistente IA
                  <span className="text-xs bg-purple-500 text-white px-2 py-1 rounded-full">Beta</span>
                </h2>
                <button onClick={() => setMostrarModalIA(false)} className="text-slate-400 hover:text-white">
                  <X className="w-6 h-6" />
                </button>
              </div>
            </div>

            <div className="p-6 space-y-6">
              {/* Texto de entrada */}
              <div>
                <label className="block text-sm font-medium text-slate-300 mb-2">Texto para processar</label>
                <textarea
                  value={textoIA}
                  onChange={(e) => setTextoIA(e.target.value)}
                  rows={4}
                  className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-purple-500 resize-none"
                  placeholder="Cole ou digite o texto aqui..."
                />
              </div>

              {/* Opções de IA */}
              <div>
                <h3 className="text-lg font-bold text-white mb-4">Melhorias de Texto</h3>
                <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
                  <button
                    onClick={() => processarIA('melhorar')}
                    disabled={processandoIA}
                    className="bg-slate-700 hover:bg-slate-600 text-white px-4 py-3 rounded-lg text-sm font-medium transition-colors disabled:opacity-50"
                  >
                    ✨ Melhorar texto
                  </button>
                  <button
                    onClick={() => processarIA('corrigir')}
                    disabled={processandoIA}
                    className="bg-slate-700 hover:bg-slate-600 text-white px-4 py-3 rounded-lg text-sm font-medium transition-colors disabled:opacity-50"
                  >
                    ✅ Corrigir português
                  </button>
                  <button
                    onClick={() => processarIA('profissional')}
                    disabled={processandoIA}
                    className="bg-slate-700 hover:bg-slate-600 text-white px-4 py-3 rounded-lg text-sm font-medium transition-colors disabled:opacity-50"
                  >
                    💼 Deixar profissional
                  </button>
                  <button
                    onClick={() => processarIA('diminuir')}
                    disabled={processandoIA}
                    className="bg-slate-700 hover:bg-slate-600 text-white px-4 py-3 rounded-lg text-sm font-medium transition-colors disabled:opacity-50"
                  >
                    📉 Diminuir texto
                  </button>
                  <button
                    onClick={() => processarIA('aumentar')}
                    disabled={processandoIA}
                    className="bg-slate-700 hover:bg-slate-600 text-white px-4 py-3 rounded-lg text-sm font-medium transition-colors disabled:opacity-50"
                  >
                    📈 Aumentar texto
                  </button>
                  <button
                    onClick={() => processarIA('traduzir')}
                    disabled={processandoIA}
                    className="bg-slate-700 hover:bg-slate-600 text-white px-4 py-3 rounded-lg text-sm font-medium transition-colors disabled:opacity-50"
                  >
                    🌍 Traduzir
                  </button>
                </div>
              </div>

              {/* Mensagens Prontas */}
              <div>
                <h3 className="text-lg font-bold text-white mb-4">Criar Mensagens</h3>
                <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
                  <button
                    onClick={() => processarIA('cobranca')}
                    disabled={processandoIA}
                    className="bg-red-900/20 hover:bg-red-900/30 border border-red-500/20 text-red-400 px-4 py-3 rounded-lg text-sm font-medium transition-colors disabled:opacity-50"
                  >
                    💰 Cobrança
                  </button>
                  <button
                    onClick={() => processarIA('venda')}
                    disabled={processandoIA}
                    className="bg-green-900/20 hover:bg-green-900/30 border border-green-500/20 text-green-400 px-4 py-3 rounded-lg text-sm font-medium transition-colors disabled:opacity-50"
                  >
                    🎯 Venda
                  </button>
                  <button
                    onClick={() => processarIA('pos-venda')}
                    disabled={processandoIA}
                    className="bg-blue-900/20 hover:bg-blue-900/30 border border-blue-500/20 text-blue-400 px-4 py-3 rounded-lg text-sm font-medium transition-colors disabled:opacity-50"
                  >
                    ⭐ Pós-venda
                  </button>
                  <button
                    onClick={() => processarIA('fgts')}
                    disabled={processandoIA}
                    className="bg-yellow-900/20 hover:bg-yellow-900/30 border border-yellow-500/20 text-yellow-400 px-4 py-3 rounded-lg text-sm font-medium transition-colors disabled:opacity-50"
                  >
                    🏦 FGTS
                  </button>
                  <button
                    onClick={() => processarIA('inss')}
                    disabled={processandoIA}
                    className="bg-purple-900/20 hover:bg-purple-900/30 border border-purple-500/20 text-purple-400 px-4 py-3 rounded-lg text-sm font-medium transition-colors disabled:opacity-50"
                  >
                    👴 INSS
                  </button>
                  <button
                    onClick={() => processarIA('refinanciamento')}
                    disabled={processandoIA}
                    className="bg-indigo-900/20 hover:bg-indigo-900/30 border border-indigo-500/20 text-indigo-400 px-4 py-3 rounded-lg text-sm font-medium transition-colors disabled:opacity-50"
                  >
                    🔄 Refinanciamento
                  </button>
                  <button
                    onClick={() => processarIA('personalizada')}
                    disabled={processandoIA}
                    className="bg-pink-900/20 hover:bg-pink-900/30 border border-pink-500/20 text-pink-400 px-4 py-3 rounded-lg text-sm font-medium transition-colors disabled:opacity-50"
                  >
                    ✏️ Personalizada
                  </button>
                </div>
              </div>

              {/* Análise e Sugestões */}
              <div>
                <h3 className="text-lg font-bold text-white mb-4">Análise Inteligente</h3>
                <div className="grid grid-cols-2 gap-3">
                  <button
                    onClick={() => processarIA('analisar')}
                    disabled={processandoIA}
                    className="bg-slate-700 hover:bg-slate-600 text-white px-4 py-3 rounded-lg text-sm font-medium transition-colors disabled:opacity-50"
                  >
                    📊 Analisar sentimento
                  </button>
                  <button
                    onClick={() => processarIA('sugerir')}
                    disabled={processandoIA}
                    className="bg-slate-700 hover:bg-slate-600 text-white px-4 py-3 rounded-lg text-sm font-medium transition-colors disabled:opacity-50"
                  >
                    💡 Sugerir resposta
                  </button>
                </div>
              </div>

              {/* Resultado */}
              {(resultadoIA || processandoIA) && (
                <div>
                  <label className="block text-sm font-medium text-slate-300 mb-2">Resultado</label>
                  <div className="bg-slate-900 border border-slate-700 rounded-lg p-4 min-h-[150px]">
                    {processandoIA ? (
                      <div className="flex items-center justify-center py-8">
                        <div className="flex flex-col items-center gap-3">
                          <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-purple-500"></div>
                          <p className="text-slate-400 text-sm">Processando com IA...</p>
                        </div>
                      </div>
                    ) : (
                      <p className="text-white whitespace-pre-wrap">{resultadoIA}</p>
                    )}
                  </div>
                </div>
              )}
            </div>

            {/* Footer */}
            <div className="p-6 border-t border-slate-700 flex gap-3">
              <button
                onClick={() => {
                  setMostrarModalIA(false)
                  setTextoIA('')
                  setResultadoIA('')
                }}
                className="flex-1 bg-slate-700 hover:bg-slate-600 text-white px-6 py-3 rounded-lg font-medium transition-colors"
              >
                Cancelar
              </button>
              <button
                onClick={usarTextoIA}
                disabled={!resultadoIA}
                className="flex-1 bg-purple-600 hover:bg-purple-700 disabled:bg-slate-700 disabled:cursor-not-allowed text-white px-6 py-3 rounded-lg font-medium transition-colors"
              >
                Usar Texto
              </button>
            </div>
          </div>
        </div>
      )}

      {/* MODAL NOVO CONTATO */}
      {mostrarModalNovoContato && (
        <div className="fixed inset-0 bg-black/70 flex items-center justify-center z-50 p-4 overflow-y-auto">
          <div className="bg-slate-800 border border-slate-700 rounded-lg max-w-4xl w-full max-h-[90vh] overflow-y-auto">
            {/* Header do Modal */}
            <div className="p-6 border-b border-slate-700 sticky top-0 bg-slate-800 z-10">
              <div className="flex items-center justify-between">
                <h2 className="text-2xl font-bold text-white flex items-center gap-2">
                  <User className="w-6 h-6 text-green-400" />
                  Novo Contato
                </h2>
                <button
                  onClick={() => setMostrarModalNovoContato(false)}
                  className="text-slate-400 hover:text-white transition-colors"
                >
                  <X className="w-6 h-6" />
                </button>
              </div>
            </div>

            {/* Formulário */}
            <div className="p-6 space-y-6">
              {/* SEÇÃO: Dados Pessoais */}
              <div>
                <h3 className="text-lg font-bold text-white mb-4 flex items-center gap-2">
                  <User className="w-5 h-5 text-green-400" />
                  Dados Pessoais
                </h3>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Nome Completo *</label>
                    <input
                      type="text"
                      value={novoContato.nome}
                      onChange={(e) => setNovoContato({...novoContato, nome: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                      placeholder="João Silva Santos"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">CPF *</label>
                    <input
                      type="text"
                      value={novoContato.cpf}
                      onChange={(e) => setNovoContato({...novoContato, cpf: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                      placeholder="000.000.000-00"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">RG</label>
                    <input
                      type="text"
                      value={novoContato.rg}
                      onChange={(e) => setNovoContato({...novoContato, rg: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                      placeholder="00.000.000-0"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">CNH</label>
                    <input
                      type="text"
                      value={novoContato.cnh}
                      onChange={(e) => setNovoContato({...novoContato, cnh: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                      placeholder="00000000000"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Data de Nascimento</label>
                    <input
                      type="date"
                      value={novoContato.nascimento}
                      onChange={(e) => setNovoContato({...novoContato, nascimento: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-green-500"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Sexo</label>
                    <select
                      value={novoContato.sexo}
                      onChange={(e) => setNovoContato({...novoContato, sexo: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-green-500"
                    >
                      <option value="">Selecione</option>
                      <option value="Masculino">Masculino</option>
                      <option value="Feminino">Feminino</option>
                      <option value="Outro">Outro</option>
                    </select>
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Estado Civil</label>
                    <select
                      value={novoContato.estadoCivil}
                      onChange={(e) => setNovoContato({...novoContato, estadoCivil: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-green-500"
                    >
                      <option value="">Selecione</option>
                      <option value="Solteiro">Solteiro(a)</option>
                      <option value="Casado">Casado(a)</option>
                      <option value="Divorciado">Divorciado(a)</option>
                      <option value="Viúvo">Viúvo(a)</option>
                    </select>
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Nacionalidade</label>
                    <input
                      type="text"
                      value={novoContato.nacionalidade}
                      onChange={(e) => setNovoContato({...novoContato, nacionalidade: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                      placeholder="Brasileira"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Nome da Mãe</label>
                    <input
                      type="text"
                      value={novoContato.nomeMae}
                      onChange={(e) => setNovoContato({...novoContato, nomeMae: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Nome do Pai</label>
                    <input
                      type="text"
                      value={novoContato.nomePai}
                      onChange={(e) => setNovoContato({...novoContato, nomePai: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                    />
                  </div>
                </div>
              </div>

              {/* SEÇÃO: Contato */}
              <div>
                <h3 className="text-lg font-bold text-white mb-4 flex items-center gap-2">
                  <Phone className="w-5 h-5 text-green-400" />
                  Contato
                </h3>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Telefone *</label>
                    <input
                      type="text"
                      value={novoContato.telefone}
                      onChange={(e) => setNovoContato({...novoContato, telefone: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                      placeholder="(11) 98765-4321"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">WhatsApp</label>
                    <input
                      type="text"
                      value={novoContato.whatsapp}
                      onChange={(e) => setNovoContato({...novoContato, whatsapp: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                      placeholder="(11) 98765-4321"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">E-mail</label>
                    <input
                      type="email"
                      value={novoContato.email}
                      onChange={(e) => setNovoContato({...novoContato, email: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                      placeholder="joao@email.com"
                    />
                  </div>
                </div>
              </div>

              {/* SEÇÃO: Endereço */}
              <div>
                <h3 className="text-lg font-bold text-white mb-4 flex items-center gap-2">
                  <MapPin className="w-5 h-5 text-green-400" />
                  Endereço
                </h3>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div className="md:col-span-2">
                    <label className="block text-sm font-medium text-slate-300 mb-2">Endereço</label>
                    <input
                      type="text"
                      value={novoContato.endereco}
                      onChange={(e) => setNovoContato({...novoContato, endereco: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                      placeholder="Rua Exemplo"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Número</label>
                    <input
                      type="text"
                      value={novoContato.numero}
                      onChange={(e) => setNovoContato({...novoContato, numero: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                      placeholder="123"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Complemento</label>
                    <input
                      type="text"
                      value={novoContato.complemento}
                      onChange={(e) => setNovoContato({...novoContato, complemento: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white placeholder-slate-400 focus:outline-none focus:border-green-500"
                      placeholder="Apto 45"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Cidade</label>
                    <input
                      type="text"
                      value={novoContato.cidade}
