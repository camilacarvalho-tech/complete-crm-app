                      value={novoContato.responsavelAtendimento}
                      onChange={(e) => setNovoContato({...novoContato, responsavelAtendimento: e.target.value})}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-green-500"
                    >
                      <option value="">Selecione</option>
                      <option value="Carlos Mendes">Carlos Mendes</option>
                      <option value="Ana Paula">Ana Paula</option>
                      <option value="João Oliveira">João Oliveira</option>
                    </select>
                  </div>
